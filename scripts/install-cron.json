{
  "commands": [
    "set -e",
    "echo '========================================='",
    "echo 'INSTALLING AND CONFIGURING CRON'",
    "echo '========================================='",
    "echo ''",
    "",
    "echo '=== 1. Install cronie package ==='",
    "if rpm -q cronie >/dev/null 2>&1; then",
    "  echo '[OK] cronie is already installed'",
    "else",
    "  echo '[INSTALLING] Installing cronie...'",
    "  yum install -y cronie",
    "  echo '[OK] cronie installed'",
    "fi",
    "echo ''",
    "",
    "echo '=== 2. Start and enable crond service ==='",
    "systemctl start crond",
    "systemctl enable crond",
    "systemctl status crond --no-pager",
    "echo '[OK] crond service is running'",
    "echo ''",
    "",
    "echo '=== 3. Configure Moodle cron for apache user ==='",
    "if crontab -u apache -l 2>/dev/null | grep -q 'admin/cli/cron.php'; then",
    "  echo '[OK] Moodle cron already configured'",
    "else",
    "  echo '[CONFIGURING] Adding Moodle cron...'",
    "  echo '* * * * * /usr/bin/php /app/moodle/admin/cli/cron.php >/dev/null 2>&1' | crontab -u apache -",
    "  echo '[OK] Moodle cron configured'",
    "fi",
    "echo ''",
    "",
    "echo '=== 4. Verify cron configuration ==='",
    "echo 'Apache user crontab:'",
    "crontab -u apache -l",
    "echo ''",
    "",
    "echo '=== 5. Verify cron configuration ==='",
    "echo 'Cron is configured and will run automatically every minute.'",
    "echo 'To manually test: sudo -u apache /usr/bin/php /app/moodle/admin/cli/cron.php'",
    "echo ''",
    "",
    "echo '========================================='",
    "echo 'CRON INSTALLATION COMPLETE'",
    "echo '========================================='",
    "echo ''",
    "echo 'Cron is now running and will execute Moodle tasks every minute.'",
    "echo ''",
    "echo 'To verify cron is working:'",
    "echo '  systemctl status crond'",
    "echo '  crontab -u apache -l'",
    "echo ''",
    "echo 'To manually run cron:'",
    "echo '  sudo -u apache /usr/bin/php /app/moodle/admin/cli/cron.php'"
  ]
}

