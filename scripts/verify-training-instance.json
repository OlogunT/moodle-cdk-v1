{
  "commands": [
    "set +e",
    "echo '================================================================'",
    "echo '   Training Moodle Instance Verification'",
    "echo '================================================================'",
    "echo",
    "echo '=== SYSTEM SERVICES ===' $(date -u)",
    "echo 'Apache:'",
    "systemctl is-active httpd && echo '  [OK] httpd is active' || echo '  [FAIL] httpd is NOT active'",
    "echo 'PHP-FPM:'",
    "systemctl is-active php-fpm && echo '  [OK] php-fpm is active' || echo '  [FAIL] php-fpm is NOT active'",
    "echo",
    "echo '=== EFS MOUNTS ==='",
    "echo 'App EFS (/app):'",
    "df -h /app | tail -1",
    "echo 'Data EFS (/data):'",
    "df -h /data | tail -1",
    "echo",
    "echo '=== MOODLE FILES ==='",
    "echo 'Config file:'",
    "if [ -f /app/moodle/config.php ]; then",
    "  echo '  [OK] /app/moodle/config.php exists'",
    "  ls -lh /app/moodle/config.php",
    "else",
    "  echo '  [FAIL] /app/moodle/config.php NOT found'",
    "fi",
    "echo",
    "echo 'Moodledata:'",
    "if [ -d /data/moodledata ]; then",
    "  echo '  [OK] /data/moodledata exists'",
    "  MDATA_SIZE=$(du -sh /data/moodledata 2>/dev/null | cut -f1)",
    "  MDATA_FILES=$(find /data/moodledata -type f 2>/dev/null | wc -l)",
    "  echo \"  Size: $MDATA_SIZE\"",
    "  echo \"  Files: $MDATA_FILES\"",
    "else",
    "  echo '  [FAIL] /data/moodledata NOT found'",
    "fi",
    "echo",
    "echo '=== PHP CONFIGURATION ==='",
    "php -r 'echo \"max_input_vars=\".ini_get(\"max_input_vars\").\"\\n\";' || echo 'PHP error'",
    "php -r 'echo \"memory_limit=\".ini_get(\"memory_limit\").\"\\n\";' || echo 'PHP error'",
    "php -r 'echo \"post_max_size=\".ini_get(\"post_max_size\").\"\\n\";' || echo 'PHP error'",
    "php -r 'echo \"upload_max_filesize=\".ini_get(\"upload_max_filesize\").\"\\n\";' || echo 'PHP error'",
    "echo",
    "echo '=== MOODLE CONFIG SETTINGS ==='",
    "echo 'Key settings from config.php:'",
    "grep -E \"wwwroot|dbtype|dbhost|dbname|dbuser|dataroot\" /app/moodle/config.php | grep -v \"^//\" | head -10 || echo 'Could not read config'",
    "echo",
    "echo '=== LOCAL HEALTH CHECK ==='",
    "HEALTH_CODE=$(curl -s -o /dev/null -w '%{http_code}' http://localhost/health)",
    "if [ \"$HEALTH_CODE\" = \"200\" ]; then",
    "  echo \"  [OK] Health endpoint: HTTP $HEALTH_CODE\"",
    "else",
    "  echo \"  [FAIL] Health endpoint: HTTP $HEALTH_CODE (expected 200)\"",
    "fi",
    "echo",
    "echo '=== LOCAL HOMEPAGE CHECK ==='",
    "HOME_CODE=$(curl -s -o /dev/null -w '%{http_code}' http://localhost/)",
    "if [ \"$HOME_CODE\" = \"200\" ] || [ \"$HOME_CODE\" = \"303\" ]; then",
    "  echo \"  [OK] Homepage: HTTP $HOME_CODE\"",
    "else",
    "  echo \"  [WARN] Homepage: HTTP $HOME_CODE\"",
    "fi",
    "echo",
    "echo '=== APACHE ERROR LOG (last 20 lines) ==='",
    "tail -n 20 /var/log/httpd/error_log || echo 'Could not read Apache error log'",
    "echo",
    "echo '=== MOODLE UPGRADE LOG (last 30 lines) ==='",
    "if [ -f /var/log/moodle-upgrade.log ]; then",
    "  tail -n 30 /var/log/moodle-upgrade.log",
    "else",
    "  echo 'No upgrade log found'",
    "fi",
    "echo",
    "echo '================================================================'",
    "echo '   Verification Complete'",
    "echo '================================================================'"
  ]
}

