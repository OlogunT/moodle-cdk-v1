{
  "commands": [
    "set -euo pipefail",
    "REGION=ca-central-1",
    "HOST=$(aws ssm get-parameter --name /moodle/redis/endpoint --region $REGION --query Parameter.Value --output text 2>/dev/null || echo '')",
    "echo Redis endpoint: $HOST",
    "sudo yum -y install -q nmap-ncat || sudo dnf -y install -q nmap-ncat || true",
    "nc -z -w2 $HOST 6379 >/dev/null 2>&1 && echo 'TCP 6379 reachable' || echo 'TCP 6379 unreachable'",
    "aws s3 cp s3://training-moodle-scripts-483382415631-ca-central-1/rebuild-config-full-from-current.sh /tmp/rebuild-config-full-from-current.sh",
    "chmod +x /tmp/rebuild-config-full-from-current.sh",
    "/tmp/rebuild-config-full-from-current.sh || echo 'Rebuild script failed'",
    "systemctl restart php-fpm || true",
    "systemctl restart httpd || true",
    "grep -n '\\\\$CFG->session_redis_host' /app/moodle/config.php || true"
  ]
}

