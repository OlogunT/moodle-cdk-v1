{
  "commands": [
    "set -e",
    "echo '========================================='",
    "echo 'FIXING MOODLE BACKUP & COPY ISSUES'",
    "echo '========================================='",
    "echo ''",
    "CFG=/app/moodle/config.php",
    "if [ ! -f \"$CFG\" ]; then",
    "  echo '[ERROR] config.php not found'",
    "  exit 1",
    "fi",
    "",
    "echo '=== Extracting DB credentials ==='",
    "DB_HOST=$(grep -E '^\\s*\\$CFG->dbhost' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_NAME=$(grep -E '^\\s*\\$CFG->dbname' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_USER=$(grep -E '^\\s*\\$CFG->dbuser' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_PASS=$(grep -E '^\\s*\\$CFG->dbpass' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DATAROOT=$(grep -E '^\\s*\\$CFG->dataroot' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "echo \"DB Host: $DB_HOST\"",
    "echo \"DB Name: $DB_NAME\"",
    "echo \"Dataroot: $DATAROOT\"",
    "echo ''",
    "",
    "echo '=== 1. Clear stuck backup controllers ==='",
    "STUCK_COUNT=$(mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -sN -e \"",
    "SELECT COUNT(*) FROM mdl_backup_controllers ",
    "WHERE status != 1000 AND timemodified < UNIX_TIMESTAMP(NOW() - INTERVAL 1 HOUR);",
    "\" 2>&1)",
    "if [ \"$STUCK_COUNT\" -gt 0 ]; then",
    "  echo \"[FIXING] Found $STUCK_COUNT stuck backup controllers (older than 1 hour)\"",
    "  mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "  UPDATE mdl_backup_controllers ",
    "  SET status = 1000 ",
    "  WHERE status != 1000 AND timemodified < UNIX_TIMESTAMP(NOW() - INTERVAL 1 HOUR);",
    "  \" 2>&1",
    "  echo '[OK] Cleared stuck backup controllers'",
    "else",
    "  echo '[OK] No stuck backup controllers found'",
    "fi",
    "echo ''",
    "",
    "echo '=== 2. Reset failed adhoc tasks ==='",
    "FAILED_COUNT=$(mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -sN -e \"",
    "SELECT COUNT(*) FROM mdl_task_adhoc ",
    "WHERE (classname LIKE '%backup%' OR classname LIKE '%copy%') ",
    "AND faildelay > 0 AND attemptsavailable > 0;",
    "\" 2>&1)",
    "if [ \"$FAILED_COUNT\" -gt 0 ]; then",
    "  echo \"[FIXING] Found $FAILED_COUNT failed adhoc tasks\"",
    "  mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "  UPDATE mdl_task_adhoc ",
    "  SET faildelay = 0, nextruntime = UNIX_TIMESTAMP(NOW()) ",
    "  WHERE (classname LIKE '%backup%' OR classname LIKE '%copy%') ",
    "  AND faildelay > 0 AND attemptsavailable > 0;",
    "  \" 2>&1",
    "  echo '[OK] Reset failed adhoc tasks'",
    "else",
    "  echo '[OK] No failed adhoc tasks found'",
    "fi",
    "echo ''",
    "",
    "echo '=== 3. Enable backup scheduled tasks ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "UPDATE mdl_task_scheduled ",
    "SET disabled = 0 ",
    "WHERE classname LIKE '%backup%' OR classname LIKE '%copy%';",
    "\" 2>&1",
    "echo '[OK] Enabled backup scheduled tasks'",
    "echo ''",
    "",
    "echo '=== 4. Fix dataroot permissions ==='",
    "if [ -d \"$DATAROOT\" ]; then",
    "  echo \"Checking $DATAROOT permissions...\"",
    "  chown -R apache:apache \"$DATAROOT\" 2>&1 || echo '[WARN] Could not change ownership'",
    "  chmod -R 755 \"$DATAROOT\" 2>&1 || echo '[WARN] Could not change permissions'",
    "  ",
    "  # Ensure backup directory exists",
    "  if [ ! -d \"$DATAROOT/backup\" ]; then",
    "    echo '[FIXING] Creating backup directory...'",
    "    mkdir -p \"$DATAROOT/backup\"",
    "    chown apache:apache \"$DATAROOT/backup\"",
    "    chmod 755 \"$DATAROOT/backup\"",
    "  fi",
    "  ",
    "  # Ensure temp directory exists",
    "  if [ ! -d \"$DATAROOT/temp\" ]; then",
    "    echo '[FIXING] Creating temp directory...'",
    "    mkdir -p \"$DATAROOT/temp\"",
    "    chown apache:apache \"$DATAROOT/temp\"",
    "    chmod 755 \"$DATAROOT/temp\"",
    "  fi",
    "  ",
    "  echo '[OK] Dataroot permissions fixed'",
    "else",
    "  echo '[ERROR] Dataroot directory not found: $DATAROOT'",
    "fi",
    "echo ''",
    "",
    "echo '=== 5. Purge Moodle caches ==='",
    "cd /app/moodle",
    "sudo -u apache /usr/bin/php admin/cli/purge_caches.php 2>&1",
    "echo '[OK] Caches purged'",
    "echo ''",
    "",
    "echo '=== 6. Run cron manually to process queue ==='",
    "echo 'Running Moodle cron (this may take a minute)...'",
    "timeout 60 sudo -u apache /usr/bin/php admin/cli/cron.php 2>&1 || echo '[INFO] Cron timed out or completed'",
    "echo ''",
    "",
    "echo '========================================='",
    "echo 'FIXES APPLIED'",
    "echo '========================================='",
    "echo ''",
    "echo 'Summary of actions taken:'",
    "echo '1. Cleared stuck backup controllers'",
    "echo '2. Reset failed adhoc tasks'",
    "echo '3. Enabled backup scheduled tasks'",
    "echo '4. Fixed dataroot permissions'",
    "echo '5. Purged Moodle caches'",
    "echo '6. Ran cron manually'",
    "echo ''",
    "echo 'IMPORTANT: Cron is not running automatically on this system.'",
    "echo 'You will need to run cron manually or set up a scheduled task.'",
    "echo 'To run cron manually: sudo -u apache /usr/bin/php /app/moodle/admin/cli/cron.php'",
    "echo ''",
    "echo 'Please try creating a backup or copying a course again.'"
  ]
}

