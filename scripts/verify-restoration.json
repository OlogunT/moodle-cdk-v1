{
  "commands": [
    "echo === Phase 4 Verification ===",
    "echo",
    "echo Step 1: Check Database Tables",
    "REGION=ca-central-1",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region $REGION --query 'SecretList[?contains(Name, `TrainingMoodleDbSecret`)].ARN' --output text)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region $REGION --query SecretString --output text)",
    "DB_HOST=$(echo \"$DB_CREDS\" | jq -r .host)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "TABLE_COUNT=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e 'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=\"moodle\";' -s -N 2>&1 | grep -v Warning)",
    "USER_COUNT=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e 'SELECT COUNT(*) FROM mdl_user;' -s -N 2>&1 | grep -v Warning)",
    "echo Database Tables: $TABLE_COUNT",
    "echo Database Users: $USER_COUNT",
    "echo",
    "echo Step 2: Check Moodledata",
    "ls -lh /data/moodledata/ | head -20",
    "echo",
    "MOODLEDATA_SIZE=$(du -sh /data/moodledata/ | cut -f1)",
    "echo Moodledata Size: $MOODLEDATA_SIZE",
    "echo",
    "echo Step 3: Check Permissions",
    "OWNER=$(stat -c '%U:%G' /data/moodledata/)",
    "PERMS=$(stat -c '%a' /data/moodledata/)",
    "echo Owner: $OWNER",
    "echo Permissions: $PERMS",
    "echo",
    "echo Step 4: Check Restoration Log",
    "if [ -f /tmp/restore.log ]; then",
    "  echo Log file exists",
    "  LOG_SIZE=$(wc -l /tmp/restore.log | cut -d' ' -f1)",
    "  echo Log lines: $LOG_SIZE",
    "  echo",
    "  echo Last 30 lines of log:",
    "  tail -30 /tmp/restore.log | tr -cd '\\11\\12\\15\\40-\\176'",
    "else",
    "  echo Log file not found",
    "fi"
  ]
}

