{
  "commands": [
    "echo === Extracting Moodledata ===",
    "BACKUP_FILE=/data/moodledata.new/etraintouchstone-learn-moodledata.tar.gz",
    "TARGET_DIR=/data/moodledata",
    "echo Backup File: $BACKUP_FILE",
    "echo Target Directory: $TARGET_DIR",
    "echo",
    "if [ ! -f \"$BACKUP_FILE\" ]; then echo Backup file not found; exit 1; fi",
    "BACKUP_SIZE=$(du -sh \"$BACKUP_FILE\" | cut -f1)",
    "echo Backup file found: $BACKUP_SIZE",
    "echo",
    "mkdir -p \"$TARGET_DIR\"",
    "echo Extracting archive - this will take 10-20 minutes...",
    "echo Started at: $(date)",
    "START_TIME=$(date +%s)",
    "cd \"$TARGET_DIR\"",
    "tar -xzf \"$BACKUP_FILE\" --strip-components=1",
    "END_TIME=$(date +%s)",
    "DURATION=$((END_TIME - START_TIME))",
    "MINUTES=$((DURATION / 60))",
    "SECONDS=$((DURATION % 60))",
    "echo Extraction completed in ${MINUTES}m ${SECONDS}s",
    "echo Completed at: $(date)",
    "echo",
    "echo Setting permissions...",
    "chown -R apache:apache \"$TARGET_DIR\"",
    "chmod -R 2777 \"$TARGET_DIR\"",
    "echo Permissions set",
    "echo",
    "FINAL_SIZE=$(du -sh \"$TARGET_DIR\" | cut -f1)",
    "FILE_COUNT=$(find \"$TARGET_DIR\" -type f | wc -l)",
    "echo Extraction complete:",
    "echo   Total size: $FINAL_SIZE",
    "echo   Files: $FILE_COUNT"
  ]
}
