{
  "commands": [
    "echo === Phase 5 Verification ===",
    "echo",
    "echo Step 1: Check config.php",
    "if [ -f /app/moodle/config.php ]; then",
    "  echo config.php exists",
    "  echo",
    "  echo Checking wwwroot:",
    "  grep wwwroot /app/moodle/config.php | head -5",
    "  echo",
    "  echo Checking database:",
    "  grep dbhost /app/moodle/config.php",
    "  grep dbname /app/moodle/config.php",
    "else",
    "  echo config.php NOT FOUND",
    "fi",
    "echo",
    "echo Step 2: Check Database Version",
    "REGION=ca-central-1",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region $REGION --query 'SecretList[?contains(Name, `TrainingMoodleDbSecret`)].ARN' --output text)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region $REGION --query SecretString --output text)",
    "DB_HOST=$(echo \"$DB_CREDS\" | jq -r .host)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "echo Database Host: $DB_HOST",
    "echo",
    "DB_VERSION=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e 'SELECT value FROM mdl_config WHERE name=\"version\";' -s -N 2>&1 | grep -v Warning)",
    "DB_RELEASE=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e 'SELECT value FROM mdl_config WHERE name=\"release\";' -s -N 2>&1 | grep -v Warning)",
    "echo Database Version: $DB_VERSION",
    "echo Database Release: $DB_RELEASE",
    "echo",
    "echo Step 3: Check Upgrade Log",
    "if [ -f /tmp/moodle-upgrade.log ]; then",
    "  echo Upgrade log exists",
    "  LOG_LINES=$(wc -l /tmp/moodle-upgrade.log | cut -d' ' -f1)",
    "  echo Log lines: $LOG_LINES",
    "  echo",
    "  echo Last 50 lines of upgrade log:",
    "  tail -50 /tmp/moodle-upgrade.log | tr -cd '\\11\\12\\15\\40-\\176'",
    "else",
    "  echo Upgrade log NOT FOUND",
    "fi",
    "echo",
    "echo Step 4: Check Configure Log",
    "if [ -f /tmp/configure-upgrade.log ]; then",
    "  echo Configure log exists",
    "  LOG_LINES=$(wc -l /tmp/configure-upgrade.log | cut -d' ' -f1)",
    "  echo Log lines: $LOG_LINES",
    "  echo",
    "  echo Last 100 lines:",
    "  tail -100 /tmp/configure-upgrade.log | tr -cd '\\11\\12\\15\\40-\\176'",
    "else",
    "  echo Configure log NOT FOUND",
    "fi"
  ]
}

