{
  "commands": [
    "set +e",
    "LOG=/var/log/moodle-500-diag.log; exec > >(tee -a \"$LOG\") 2>&1",
    "echo '=== DIAG START ===' $(date -u)",
    "echo '--- SERVICES ---'",
    "systemctl is-active httpd || true",
    "systemctl is-active php-fpm || true",
    "echo '--- PHP ---'",
    "php -v || true",
    "php -r 'echo "max_input_vars=".ini_get("max_input_vars")."\n";' || true",
    "php -m | tr '\n' ' ' | fold -s -w 120 || true",
    "echo '--- CONFIG LINT ---'",
    "php -l /app/moodle/config.php || true",
    "echo '--- CONFIG EXCERPT ---'",
    "nl -ba /app/moodle/config.php | sed -n '1,80p' || true",
    "echo '--- CONFIG FLAGS ORDER ---'",
    "awk '/wwwroot|reverseproxy|sslproxy|cookiesecure|loginhttps|getremoteaddrconf|require_once.*lib\\/setup\\.php/ {print NR \" : \" $0}' /app/moodle/config.php || true",
    "echo '--- PERMS ---'",
    "id apache || true",
    "ls -ld /app/moodle /data/moodledata || true",
    "ls -ld /data/moodledata /data/moodledata/sessions || true",
    "touch /data/moodledata/.writetest && echo OK_WRITE && rm -f /data/moodledata/.writetest || echo WRITE_FAIL",
    "echo '--- SELINUX ---'",
    "getenforce 2>/dev/null || echo 'no-selinux'",
    "echo '--- HTTPD CONF ---'",
    "sed -n '1,160p' /etc/httpd/conf.d/moodle.conf || true",
    "echo '--- FPM POOL ---'",
    "grep -E '^(user|group)\s*=' /etc/php-fpm.d/www.conf || true",
    "echo '--- CURL LOCALHOST ---'",
    "curl -sI http://localhost/ | sed -n '1,20p'",
    "curl -s -o /dev/null -w '%{http_code}\n' http://localhost/",
    "curl -s -o /dev/null -w '%{http_code}\n' http://localhost/health",
    "echo '--- APACHE ERROR LOG (last 120) ---'",
    "tail -n 120 /var/log/httpd/error_log || true",
    "echo '--- MOODLE ERROR LOG (last 120) ---'",
    "tail -n 120 /var/log/httpd/moodle_error.log || true",
    "echo '--- INSTALL LOG (last 120) ---'",
    "tail -n 120 /var/log/moodle-install.log || true",
    "echo '--- DB WWWROOT/CFG IN DB ---'",
    "DBHOST=$(awk -F\"\" '/\$CFG->dbhost/{print $2}' /app/moodle/config.php); DBNAME=$(awk -F\"\" '/\$CFG->dbname/{print $2}' /app/moodle/config.php); DBUSER=$(awk -F\"\" '/\$CFG->dbuser/{print $2}' /app/moodle/config.php); DBPASS=$(awk -F\"\" '/\$CFG->dbpass/{print $2}' /app/moodle/config.php); echo \"DBHOST=$DBHOST DBNAME=$DBNAME\"; mariadb -h \"$DBHOST\" -u \"$DBUSER\" -p\"$DBPASS\" -D \"$DBNAME\" -e \"SELECT name,value FROM mdl_config WHERE name IN ('wwwroot','reverseproxy','sslproxy','cookiesecure','loginhttps','getremoteaddrconf');\" 2>/dev/null || true",
    "echo '=== DIAG END ===' $(date -u)"
  ]
}

