{
  "commands": [
    "set -e",
    "echo '========================================='",
    "echo 'MOODLE BACKUP & COPY DIAGNOSTICS'",
    "echo '========================================='",
    "echo ''",
    "CFG=/app/moodle/config.php",
    "if [ ! -f \"$CFG\" ]; then",
    "  echo '[ERROR] config.php not found at /app/moodle/config.php'",
    "  exit 1",
    "fi",
    "",
    "echo '=== Extracting DB credentials ==='",
    "DB_HOST=$(grep -E '^\\s*\\$CFG->dbhost' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_NAME=$(grep -E '^\\s*\\$CFG->dbname' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_USER=$(grep -E '^\\s*\\$CFG->dbuser' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_PASS=$(grep -E '^\\s*\\$CFG->dbpass' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "echo \"DB Host: $DB_HOST\"",
    "echo \"DB Name: $DB_NAME\"",
    "echo \"DB User: $DB_USER\"",
    "echo ''",
    "",
    "echo '=== 1. CRON STATUS ==='",
    "systemctl is-active crond && echo '[OK] crond is active' || echo '[ERROR] crond is NOT active'",
    "echo ''",
    "echo '-- Moodle cron configuration --'",
    "grep -R \"admin/cli/cron.php\" /etc/cron* /var/spool/cron 2>/dev/null || echo '[WARN] No Moodle cron found in system cron'",
    "echo ''",
    "",
    "echo '=== 2. SCHEDULED TASKS STATUS ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  classname,",
    "  FROM_UNIXTIME(lastruntime) as last_run,",
    "  FROM_UNIXTIME(nextruntime) as next_run,",
    "  faildelay,",
    "  disabled",
    "FROM mdl_task_scheduled ",
    "WHERE classname LIKE '%backup%' OR classname LIKE '%copy%'",
    "ORDER BY lastruntime DESC;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== 3. ADHOC TASKS (Backup/Copy Queue) ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  id,",
    "  classname,",
    "  FROM_UNIXTIME(timecreated) as created,",
    "  FROM_UNIXTIME(nextruntime) as next_run,",
    "  faildelay,",
    "  attemptsavailable",
    "FROM mdl_task_adhoc ",
    "WHERE classname LIKE '%backup%' OR classname LIKE '%copy%' OR classname LIKE '%async%'",
    "ORDER BY timecreated DESC ",
    "LIMIT 20;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== 4. BACKUP CONTROLLER STATUS ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  bc.backupid,",
    "  bc.operation,",
    "  bc.type,",
    "  bc.itemid as course_id,",
    "  bc.status,",
    "  bc.execution,",
    "  FROM_UNIXTIME(bc.timecreated) as created,",
    "  FROM_UNIXTIME(bc.timemodified) as modified,",
    "  c.fullname as course_name",
    "FROM mdl_backup_controllers bc",
    "LEFT JOIN mdl_course c ON bc.itemid = c.id",
    "WHERE bc.status != 1000",
    "ORDER BY bc.timecreated DESC ",
    "LIMIT 20;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== 5. COURSE COPY STATUS ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  id,",
    "  operation,",
    "  origin,",
    "  destination,",
    "  status,",
    "  FROM_UNIXTIME(timecreated) as created,",
    "  FROM_UNIXTIME(timemodified) as modified",
    "FROM mdl_backup_courses",
    "ORDER BY timecreated DESC ",
    "LIMIT 10;",
    "\" 2>&1 || echo '[INFO] mdl_backup_courses table may not exist in this Moodle version'",
    "echo ''",
    "",
    "echo '=== 6. CHECK SPECIFIC COURSE (Family Medicine Asyncronous Course) ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  id,",
    "  fullname,",
    "  shortname,",
    "  category,",
    "  visible,",
    "  format",
    "FROM mdl_course ",
    "WHERE fullname LIKE '%Family Medicine%Async%'",
    "LIMIT 5;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== 7. COURSE SETTINGS DATABASE CHECK ==='",
    "COURSE_ID=$(mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -sN -e \"SELECT id FROM mdl_course WHERE fullname LIKE '%Family Medicine%Async%' LIMIT 1;\" 2>&1)",
    "if [ -n \"$COURSE_ID\" ] && [ \"$COURSE_ID\" != \"ERROR\" ]; then",
    "  echo \"Found course ID: $COURSE_ID\"",
    "  echo ''",
    "  echo '-- Course format options --'",
    "  mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "  SELECT * FROM mdl_course_format_options WHERE courseid = $COURSE_ID;",
    "  \" 2>&1",
    "  echo ''",
    "  echo '-- Course sections --'",
    "  mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "  SELECT id, course, section, name, visible FROM mdl_course_sections WHERE course = $COURSE_ID LIMIT 10;",
    "  \" 2>&1",
    "else",
    "  echo '[WARN] Could not find Family Medicine course'",
    "fi",
    "echo ''",
    "",
    "echo '=== 8. PHP ERROR LOG (last 50 lines) ==='",
    "tail -n 50 /var/log/php-fpm/error.log 2>/dev/null || echo '[INFO] PHP error log not found'",
    "echo ''",
    "",
    "echo '=== 9. APACHE ERROR LOG (last 30 lines) ==='",
    "tail -n 30 /var/log/httpd/error_log 2>/dev/null || echo '[INFO] Apache error log not found'",
    "echo ''",
    "",
    "echo '=== 10. MOODLE DATA DIRECTORY PERMISSIONS ==='",
    "DATAROOT=$(grep -E '^\\s*\\$CFG->dataroot' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "echo \"Dataroot: $DATAROOT\"",
    "ls -ld \"$DATAROOT\" 2>&1",
    "ls -ld \"$DATAROOT/temp\" 2>&1 || echo '[WARN] temp directory not found'",
    "ls -ld \"$DATAROOT/backup\" 2>&1 || echo '[WARN] backup directory not found'",
    "echo ''",
    "",
    "echo '========================================='",
    "echo 'DIAGNOSTICS COMPLETE'",
    "echo '========================================='",
    "echo ''",
    "echo 'Next steps:'",
    "echo '1. Check if cron is running'",
    "echo '2. Look for stuck backup controllers (status != 1000)'",
    "echo '3. Check adhoc tasks queue for pending backups'",
    "echo '4. Review error logs for database or permission issues'"
  ]
}

