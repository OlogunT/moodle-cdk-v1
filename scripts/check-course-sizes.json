{
  "commands": [
    "set -e",
    "echo '========================================='",
    "echo 'CHECKING COURSE SIZES AND BACKUP STATUS'",
    "echo '========================================='",
    "echo ''",
    "CFG=/app/moodle/config.php",
    "if [ ! -f \"$CFG\" ]; then",
    "  echo '[ERROR] config.php not found'",
    "  exit 1",
    "fi",
    "",
    "echo '=== Extracting DB credentials ==='",
    "DB_HOST=$(grep -E '^\\s*\\$CFG->dbhost' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_NAME=$(grep -E '^\\s*\\$CFG->dbname' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_USER=$(grep -E '^\\s*\\$CFG->dbuser' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DB_PASS=$(grep -E '^\\s*\\$CFG->dbpass' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "DATAROOT=$(grep -E '^\\s*\\$CFG->dataroot' \"$CFG\" | sed -E \"s/.*=\\s*['\\\"]([^'\\\"]*)['\\\"].*/\\1/\")",
    "echo \"Dataroot: $DATAROOT\"",
    "echo ''",
    "",
    "echo '=== Course File Sizes ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  c.id,",
    "  c.fullname,",
    "  COUNT(f.id) as file_count,",
    "  ROUND(SUM(f.filesize)/1024/1024, 2) as size_mb",
    "FROM mdl_course c",
    "LEFT JOIN mdl_context ctx ON ctx.instanceid = c.id AND ctx.contextlevel = 50",
    "LEFT JOIN mdl_files f ON f.contextid = ctx.id AND f.filename != '.'",
    "WHERE c.id IN (77, 102)",
    "GROUP BY c.id, c.fullname",
    "ORDER BY size_mb DESC;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== Check if cron is actually running ==='",
    "ps aux | grep -E 'cron\\.php|php.*cron' | grep -v grep || echo 'No cron process found'",
    "echo ''",
    "",
    "echo '=== Check recent backup activity in temp directory ==='",
    "if [ -d \"$DATAROOT/temp/backup\" ]; then",
    "  echo 'Recent backup temp files:'",
    "  find \"$DATAROOT/temp/backup\" -type f -mmin -10 -ls 2>/dev/null | head -20 || echo 'No recent backup files'",
    "else",
    "  echo 'No temp/backup directory found'",
    "fi",
    "echo ''",
    "",
    "echo '=== Check if backup directory was created ==='",
    "if [ -d \"$DATAROOT/backup\" ]; then",
    "  echo 'Backup directory exists:'",
    "  ls -lh \"$DATAROOT/backup\" | head -20",
    "else",
    "  echo 'Backup directory does NOT exist'",
    "fi",
    "echo ''",
    "",
    "echo '=== Check current backup controller status ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  bc.backupid,",
    "  bc.itemid as course_id,",
    "  c.fullname,",
    "  bc.status,",
    "  bc.execution,",
    "  FROM_UNIXTIME(bc.timecreated) as created,",
    "  FROM_UNIXTIME(bc.timemodified) as modified,",
    "  TIMESTAMPDIFF(MINUTE, FROM_UNIXTIME(bc.timemodified), NOW()) as minutes_since_modified",
    "FROM mdl_backup_controllers bc",
    "LEFT JOIN mdl_course c ON bc.itemid = c.id",
    "WHERE bc.status != 1000",
    "ORDER BY bc.timemodified DESC ",
    "LIMIT 10;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== Check adhoc task queue ==='",
    "mariadb -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"",
    "SELECT ",
    "  id,",
    "  classname,",
    "  FROM_UNIXTIME(timecreated) as created,",
    "  FROM_UNIXTIME(nextruntime) as next_run,",
    "  faildelay,",
    "  attemptsavailable,",
    "  TIMESTAMPDIFF(MINUTE, FROM_UNIXTIME(timecreated), NOW()) as minutes_old",
    "FROM mdl_task_adhoc ",
    "WHERE classname LIKE '%backup%' OR classname LIKE '%copy%'",
    "ORDER BY timecreated DESC ",
    "LIMIT 10;",
    "\" 2>&1",
    "echo ''",
    "",
    "echo '=== System Load ==='",
    "uptime",
    "echo ''",
    "echo '=== Memory Usage ==='",
    "free -h",
    "echo ''",
    "echo '=== Disk Usage ==='",
    "df -h | grep -E 'Filesystem|/data|/app'",
    "echo ''",
    "",
    "echo '========================================='",
    "echo 'ANALYSIS COMPLETE'",
    "echo '========================================='",
    "echo ''",
    "echo 'If backup controllers have not been modified in >5 minutes,'",
    "echo 'and no cron process is running, the cron execution may be stuck.'"
  ]
}

