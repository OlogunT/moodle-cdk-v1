{
  "commands": [
    "#!/bin/bash",
    "set -e",
    "",
    "echo '=== Creating New Admin Account ==='",
    "echo ''",
    "",
    "cd /app/moodle",
    "",
    "REGION=ca-central-1",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region $REGION --query 'SecretList[?contains(Name,`TrainingMoodleDbSecret`)].ARN' --output text)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region $REGION --query SecretString --output text)",
    "DB_HOST=$(echo \"$DB_CREDS\" | jq -r .host)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "",
    "echo 'Generating password hash using Moodle...'",
    "",
    "cat > /tmp/hash_password.php << 'EOFPHP'",
    "<?php",
    "define('CLI_SCRIPT', true);",
    "require('/app/moodle/config.php');",
    "require_once($CFG->libdir.'/moodlelib.php');",
    "$password = 'TsinAdmin2025!@#$%';",
    "$hash = hash_internal_user_password($password);",
    "echo $hash;",
    "?>",
    "EOFPHP",
    "",
    "PASSWORD_HASH=$(sudo -u apache php /tmp/hash_password.php)",
    "rm -f /tmp/hash_password.php",
    "",
    "echo 'Password hash generated'",
    "echo ''",
    "echo 'Creating user: tsin-admin'",
    "",
    "mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle << EOFSQL 2>&1 | grep -v 'Warning'",
    "INSERT INTO mdl_user (",
    "  auth, confirmed, policyagreed, deleted, suspended, mnethostid,",
    "  username, password, firstname, lastname, email,",
    "  emailstop, mailformat, maildigest, maildisplay, autosubscribe,",
    "  trackforums, timecreated, timemodified, trustbitmask, imagealt,",
    "  lastnamephonetic, firstnamephonetic, middlename, alternatename, lang",
    ") VALUES (",
    "  'manual', 1, 0, 0, 0, 1,",
    "  'tsin-admin', '$PASSWORD_HASH', 'TSIN', 'Admin', 'it@tsin.ca',",
    "  0, 1, 0, 2, 1,",
    "  0, UNIX_TIMESTAMP(), UNIX_TIMESTAMP(), 0, '',",
    "  '', '', '', '', 'en'",
    ");",
    "EOFSQL",
    "",
    "USER_ID=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"SELECT id FROM mdl_user WHERE username='tsin-admin';\" -s -N 2>&1 | grep -v 'Warning')",
    "",
    "echo \"User created with ID: $USER_ID\"",
    "echo ''",
    "",
    "echo 'Assigning site admin role...'",
    "mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"INSERT INTO mdl_role_assignments (roleid, contextid, userid, timemodified, modifierid) VALUES (1, 1, $USER_ID, UNIX_TIMESTAMP(), 2);\" 2>&1 | grep -v 'Warning'",
    "",
    "echo ''",
    "echo 'Adding to siteadmins config...'",
    "",
    "CURRENT_ADMINS=$(mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"SELECT value FROM mdl_config WHERE name='siteadmins';\" -s -N 2>&1 | grep -v 'Warning')",
    "NEW_ADMINS=\"${CURRENT_ADMINS},${USER_ID}\"",
    "",
    "mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"UPDATE mdl_config SET value='$NEW_ADMINS' WHERE name='siteadmins';\" 2>&1 | grep -v 'Warning'",
    "",
    "echo ''",
    "echo '=== Admin Account Created Successfully ==='",
    "echo ''",
    "echo 'Username: tsin-admin'",
    "echo 'Email: it@tsin.ca'",
    "echo 'Password: TsinAdmin2025!@#$%'",
    "echo \"User ID: $USER_ID\"",
    "echo ''",
    "",
    "echo 'Verifying account...'",
    "mysql -h \"$DB_HOST\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"SELECT id, username, email, firstname, lastname FROM mdl_user WHERE username='tsin-admin';\" 2>&1 | grep -v 'Warning'",
    "",
    "echo ''",
    "echo 'Purging caches...'",
    "sudo -u apache php admin/cli/purge_caches.php",
    "",
    "echo ''",
    "echo '=== Complete ==='",
    "echo 'You can now log in at https://training.tsin.ca/login/'"
  ]
}

