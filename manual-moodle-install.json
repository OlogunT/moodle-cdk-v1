{
  "Parameters": {
    "commands": [
      "echo '=== MANUAL MOODLE INSTALLATION ==='",
      "cd /app/moodle",
      "echo '--- Set region explicitly ---'",
      "REGION='ca-central-1'",
      "echo \"Using region: $REGION\"",
      "echo '--- Get ALB URL directly ---'",
      "ALB_DNS=$(aws elbv2 describe-load-balancers --region $REGION --query \"LoadBalancers[?contains(LoadBalancerName, 'Moodle')].DNSName\" --output text 2>/dev/null | head -1)",
      "if [ -n \"$ALB_DNS\" ]; then",
      "  ALB_URL=\"http://$ALB_DNS\"",
      "else",
      "  ALB_URL=\"http://moodle-moodl-3wp8ysl2xtuu-1534359783.ca-central-1.elb.amazonaws.com\"",
      "fi",
      "echo \"ALB_URL: $ALB_URL\"",
      "echo '--- Get RDS endpoint directly ---'",
      "DB_ENDPOINT=$(aws rds describe-db-instances --region $REGION --query \"DBInstances[?contains(DBInstanceIdentifier, 'moodle') || contains(DBInstanceIdentifier, 'Moodle')].Endpoint.Address\" --output text 2>/dev/null | head -1)",
      "if [ -z \"$DB_ENDPOINT\" ]; then",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region $REGION --query \"DBInstances[0].Endpoint.Address\" --output text 2>/dev/null)",
      "fi",
      "echo \"DB_ENDPOINT: $DB_ENDPOINT\"",
      "echo '--- Get DB credentials ---'",
      "SECRET_ARN=$(aws secretsmanager list-secrets --region $REGION --query \"SecretList[?contains(Name, 'moodle') || contains(Name, 'Moodle') || contains(Name, 'rds')].ARN\" --output text 2>/dev/null | head -1)",
      "if [ -n \"$SECRET_ARN\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region $REGION --secret-id \"$SECRET_ARN\" --query SecretString --output text 2>/dev/null)",
      "  DB_USER=$(echo \"$DB_CREDS\" | jq -r .username 2>/dev/null)",
      "  DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password 2>/dev/null)",
      "else",
      "  echo 'No secrets found, using defaults'",
      "  DB_USER='admin'",
      "  DB_PASS='password123'",
      "fi",
      "echo \"DB_USER: $DB_USER\"",
      "echo \"SECRET_ARN: $SECRET_ARN\"",
      "echo '--- Ensure data directory exists ---'",
      "mkdir -p /data/moodledata",
      "chown -R apache:apache /data/moodledata",
      "chmod -R 777 /data/moodledata",
      "echo '--- Remove any existing config ---'",
      "rm -f /app/moodle/config.php",
      "echo '--- Install Moodle ---'",
      "if [ -n \"$DB_ENDPOINT\" ] && [ -n \"$DB_USER\" ] && [ -n \"$ALB_URL\" ] && [ \"$ALB_URL\" != \"http://\" ]; then",
      "  echo 'Starting Moodle CLI installation...'",
      "  sudo -u apache php admin/cli/install.php \\",
      "    --lang=en \\",
      "    --wwwroot=\"$ALB_URL\" \\",
      "    --dataroot=\"/data/moodledata\" \\",
      "    --dbtype=mariadb \\",
      "    --dbhost=\"$DB_ENDPOINT\" \\",
      "    --dbname=moodle \\",
      "    --dbuser=\"$DB_USER\" \\",
      "    --dbpass=\"$DB_PASS\" \\",
      "    --dbport=3306 \\",
      "    --prefix=mdl_ \\",
      "    --fullname=\"Touchstone Institute\" \\",
      "    --shortname=\"TSI\" \\",
      "    --adminuser=\"moodle-admin\" \\",
      "    --adminpass=\"TempPass123!\" \\",
      "    --adminemail=\"it@tsin.ca\" \\",
      "    --non-interactive \\",
      "    --agree-license",
      "  echo 'Installation command completed'",
      "else",
      "  echo 'ERROR: Still missing required parameters'",
      "  echo \"DB_ENDPOINT: $DB_ENDPOINT\"",
      "  echo \"DB_USER: $DB_USER\"",
      "  echo \"ALB_URL: $ALB_URL\"",
      "fi",
      "echo '--- Create health check ---'",
      "cat > /app/moodle/health.php << 'EOF'",
      "<?php",
      "http_response_code(200);",
      "echo 'OK';",
      "?>",
      "EOF",
      "chown apache:apache /app/moodle/health.php",
      "echo '--- Set permissions ---'",
      "chown -R apache:apache /app/moodle /data/moodledata",
      "echo '--- Check final result ---'",
      "ls -la /app/moodle/config.php || echo 'Config still missing!'",
      "if [ -f /app/moodle/config.php ]; then",
      "  echo 'Config found! Checking wwwroot:'",
      "  grep wwwroot /app/moodle/config.php",
      "fi",
      "echo '--- Test access ---'",
      "curl -sI http://localhost/ | head -3",
      "echo '=== INSTALLATION COMPLETE ==='"
    ]
  }
}
