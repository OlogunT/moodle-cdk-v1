{
  "commands": [
    "echo '=== EMERGENCY DIAGNOSIS - 504 GATEWAY TIMEOUT ==='",
    "echo ''",
    "echo '=== 1. CHECK SERVICE STATUS ==='",
    "systemctl status httpd --no-pager -l | head -20",
    "echo ''",
    "systemctl status php-fpm --no-pager -l | head -20",
    "echo ''",
    "echo '=== 2. CHECK IF SERVICES ARE RESPONSIVE ==='",
    "ps aux | grep -E 'httpd|php-fpm' | grep -v grep | head -10",
    "echo ''",
    "echo '=== 3. CHECK RECENT ERROR LOGS ==='",
    "echo '--- Apache Error Log (last 30 lines) ---'",
    "tail -30 /var/log/httpd/error_log 2>/dev/null || echo 'No Apache error log'",
    "echo ''",
    "echo '--- Moodle Error Log (last 30 lines) ---'",
    "tail -30 /var/log/httpd/moodle_error.log 2>/dev/null || echo 'No Moodle error log'",
    "echo ''",
    "echo '--- PHP-FPM Error Log (last 30 lines) ---'",
    "tail -30 /var/log/php-fpm/error.log 2>/dev/null || echo 'No PHP-FPM error log'",
    "echo ''",
    "echo '=== 4. CHECK PHP-FPM POOL STATUS ==='",
    "systemctl status php-fpm --no-pager | grep -E 'Active|Main PID|Memory'",
    "echo ''",
    "echo '=== 5. TEST LOCAL PHP EXECUTION ==='",
    "timeout 5 php -r 'echo \"PHP is working\\n\";' || echo 'PHP execution timed out or failed'",
    "echo ''",
    "echo '=== 6. CHECK SYSTEM RESOURCES ==='",
    "echo '--- Memory ---'",
    "free -h",
    "echo ''",
    "echo '--- CPU Load ---'",
    "uptime",
    "echo ''",
    "echo '--- Disk Space ---'",
    "df -h | grep -E 'Filesystem|/app|/data|/$'",
    "echo ''",
    "echo '=== 7. TEST SIMPLE PHP FILE ==='",
    "echo '<?php echo \"OK\"; ?>' > /tmp/test.php",
    "timeout 5 php /tmp/test.php || echo 'Simple PHP test failed'",
    "rm -f /tmp/test.php",
    "echo ''",
    "echo '=== 8. CHECK FOR PHP FATAL ERRORS IN MODIFIED FILES ==='",
    "timeout 5 php -l /app/moodle/course/format/menutopic/lib.php || echo 'Syntax check failed or timed out'",
    "timeout 5 php -l /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php || echo 'Syntax check failed or timed out'",
    "echo ''",
    "echo '=== 9. CHECK EFS MOUNT STATUS ==='",
    "df -h | grep -E '/app|/data'",
    "mount | grep -E '/app|/data'",
    "echo ''",
    "echo '=== 10. TEST BASIC HTTP REQUEST ==='",
    "timeout 10 curl -sL -w 'HTTP: %{http_code}\\n' -o /dev/null http://localhost/ || echo 'Main page request timed out'",
    "echo ''",
    "echo '=== DIAGNOSIS COMPLETE ==='",
    "date"
  ]
}

