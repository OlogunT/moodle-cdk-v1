{
  "Parameters": {
    "commands": [
      "echo '=== FIXING REDIRECT LOOP ==='",
      "cd /app/moodle",
      "echo '--- Check current config.php ---'",
      "if [ -f /app/moodle/config.php ]; then",
      "  echo 'Current config.php exists:'",
      "  grep -E 'wwwroot|dbhost|dbuser' /app/moodle/config.php || echo 'No matching lines found'",
      "else",
      "  echo 'No config.php found!'",
      "fi",
      "echo '--- Check what URL Moodle thinks it should redirect to ---'",
      "curl -sI http://localhost/ | grep -i location || echo 'No location header found'",
      "echo '--- Check Apache configuration ---'",
      "grep -E 'DocumentRoot|ServerName' /etc/httpd/conf.d/moodle.conf || echo 'No Apache config found'",
      "echo '--- Check for .htaccess files that might cause redirects ---'",
      "find /app/moodle -name '.htaccess' -exec echo 'Found .htaccess: {}' \\; -exec cat {} \\; || echo 'No .htaccess files found'",
      "echo '--- Test direct access to index.php ---'",
      "curl -sI http://localhost/index.php | head -5",
      "echo '--- Check Moodle database for wwwroot setting ---'",
      "REGION='ca-central-1'",
      "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'Moodle') || contains(Name, 'Db')].ARN\" --output text | head -1)",
      "if [ -n \"$DB_SECRET_ARN\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region \"$REGION\" --secret-id \"$DB_SECRET_ARN\" --query SecretString --output text)",
      "  DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
      "  DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[0].Endpoint.Address\" --output text)",
      "  echo \"Checking database wwwroot setting...\"",
      "  mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"SELECT name, value FROM mdl_config WHERE name='wwwroot';\" 2>/dev/null || echo 'Could not query database'",
      "fi",
      "echo '--- Fix the redirect loop ---'",
      "ALB_URL='http://moodle-moodl-3wp8ysl2xtuu-1534359783.ca-central-1.elb.amazonaws.com'",
      "echo \"Target ALB URL: $ALB_URL\"",
      "echo '--- Update config.php with correct wwwroot ---'",
      "if [ -f /app/moodle/config.php ]; then",
      "  # Backup current config",
      "  cp /app/moodle/config.php /app/moodle/config.php.backup",
      "  # Update wwwroot in config.php",
      "  sed -i \"s|\\$CFG->wwwroot.*|\\$CFG->wwwroot   = '$ALB_URL';|\" /app/moodle/config.php",
      "  echo 'Updated config.php wwwroot setting'",
      "  grep wwwroot /app/moodle/config.php",
      "else",
      "  echo 'Creating new config.php...'",
      "  cat > /app/moodle/config.php << 'CONFIG_EOF'",
      "<?php",
      "unset($CFG);",
      "global $CFG;",
      "$CFG = new stdClass();",
      "",
      "$CFG->dbtype    = 'mariadb';",
      "$CFG->dblibrary = 'native';",
      "$CFG->dbhost    = 'DB_ENDPOINT_PLACEHOLDER';",
      "$CFG->dbname    = 'moodle';",
      "$CFG->dbuser    = 'DB_USER_PLACEHOLDER';",
      "$CFG->dbpass    = 'DB_PASS_PLACEHOLDER';",
      "$CFG->prefix    = 'mdl_';",
      "$CFG->dboptions = array (",
      "  'dbpersist' => 0,",
      "  'dbport' => 3306,",
      "  'dbsocket' => '',",
      "  'dbcollation' => 'utf8mb4_unicode_ci',",
      ");",
      "",
      "$CFG->wwwroot   = 'ALB_URL_PLACEHOLDER';",
      "$CFG->dataroot  = '/data/moodledata';",
      "$CFG->admin     = 'admin';",
      "",
      "$CFG->directorypermissions = 0777;",
      "",
      "require_once(__DIR__ . '/lib/setup.php');",
      "CONFIG_EOF",
      "  # Replace placeholders with actual values",
      "  sed -i \"s|DB_ENDPOINT_PLACEHOLDER|$DB_ENDPOINT|g\" /app/moodle/config.php",
      "  sed -i \"s|DB_USER_PLACEHOLDER|$DB_USER|g\" /app/moodle/config.php",
      "  sed -i \"s|DB_PASS_PLACEHOLDER|$DB_PASS|g\" /app/moodle/config.php",
      "  sed -i \"s|ALB_URL_PLACEHOLDER|$ALB_URL|g\" /app/moodle/config.php",
      "  chown apache:apache /app/moodle/config.php",
      "  chmod 644 /app/moodle/config.php",
      "  echo 'Created new config.php'",
      "fi",
      "echo '--- Update database wwwroot if accessible ---'",
      "if [ -n \"$DB_ENDPOINT\" ] && [ -n \"$DB_USER\" ] && [ -n \"$DB_PASS\" ]; then",
      "  echo 'Updating database wwwroot setting...'",
      "  mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"UPDATE mdl_config SET value='$ALB_URL' WHERE name='wwwroot';\" 2>/dev/null && echo 'Database wwwroot updated' || echo 'Could not update database'",
      "fi",
      "echo '--- Clear any Moodle caches ---'",
      "rm -rf /data/moodledata/cache/* 2>/dev/null || echo 'No cache to clear'",
      "rm -rf /data/moodledata/localcache/* 2>/dev/null || echo 'No localcache to clear'",
      "echo '--- Restart Apache to clear any cached redirects ---'",
      "systemctl restart httpd",
      "sleep 3",
      "echo '--- Test the fix ---'",
      "echo 'Testing localhost access:'",
      "curl -sI http://localhost/ | head -5",
      "echo 'Testing direct index.php:'",
      "curl -sI http://localhost/index.php | head -5",
      "echo '--- Final config check ---'",
      "echo 'Final wwwroot in config.php:'",
      "grep wwwroot /app/moodle/config.php || echo 'No wwwroot found in config'",
      "echo '=== REDIRECT LOOP FIX COMPLETE ==='"
    ]
  }
}
