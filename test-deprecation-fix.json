{
  "commands": [
    "set -euo pipefail",
    "echo '=== COMPREHENSIVE TEST SUITE FOR DEPRECATION FIX ==='",
    "echo ''",
    "echo '=== TEST 1: VERIFY FILES WERE MODIFIED ==='",
    "echo 'Checking menutopic/lib.php line 113...'",
    "sed -n '113p' /app/moodle/course/format/menutopic/lib.php",
    "if grep -q 'set_sectionnum' /app/moodle/course/format/menutopic/lib.php; then",
    "  echo '✓ PASS: menutopic uses set_sectionnum()'",
    "else",
    "  echo '✗ FAIL: menutopic still uses old method'",
    "  exit 1",
    "fi",
    "echo ''",
    "echo 'Checking topcoll/format_renderer_migration_toolbox.php line 151...'",
    "sed -n '151p' /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php",
    "if grep -q 'set_sectionnum' /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php; then",
    "  echo '✓ PASS: topcoll uses set_sectionnum()'",
    "else",
    "  echo '✗ FAIL: topcoll still uses old method'",
    "  exit 1",
    "fi",
    "echo ''",
    "echo '=== TEST 2: VERIFY NO DEPRECATED METHODS REMAIN ==='",
    "DEPRECATED_COUNT=$(grep -r 'set_section_number' /app/moodle/course/format/menutopic/ /app/moodle/course/format/topcoll/ 2>/dev/null | grep -v '.backup' | wc -l)",
    "echo \"Found $DEPRECATED_COUNT instances of set_section_number (excluding backups)\"",
    "if [ \"$DEPRECATED_COUNT\" -eq 0 ]; then",
    "  echo '✓ PASS: No deprecated methods in active code'",
    "else",
    "  echo '✗ WARNING: Still found deprecated methods:'",
    "  grep -rn 'set_section_number' /app/moodle/course/format/menutopic/ /app/moodle/course/format/topcoll/ 2>/dev/null | grep -v '.backup' || true",
    "fi",
    "echo ''",
    "echo '=== TEST 3: VERIFY BACKUPS EXIST ==='",
    "if [ -f /app/moodle/course/format/menutopic/lib.php.backup.20251018_050542 ]; then",
    "  echo '✓ PASS: menutopic backup exists'",
    "  ls -lh /app/moodle/course/format/menutopic/lib.php.backup.20251018_050542",
    "else",
    "  echo '✗ FAIL: menutopic backup missing'",
    "fi",
    "if [ -f /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php.backup.20251018_050542 ]; then",
    "  echo '✓ PASS: topcoll backup exists'",
    "  ls -lh /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php.backup.20251018_050542",
    "else",
    "  echo '✗ FAIL: topcoll backup missing'",
    "fi",
    "echo ''",
    "echo '=== TEST 4: PHP SYNTAX VALIDATION ==='",
    "php -l /app/moodle/course/format/menutopic/lib.php",
    "php -l /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php",
    "echo '✓ PASS: All PHP files have valid syntax'",
    "echo ''",
    "echo '=== TEST 5: APACHE/PHP-FPM STATUS ==='",
    "systemctl is-active httpd && echo '✓ PASS: Apache is running' || echo '✗ FAIL: Apache is down'",
    "systemctl is-active php-fpm && echo '✓ PASS: PHP-FPM is running' || echo '✗ FAIL: PHP-FPM is down'",
    "echo ''",
    "echo '=== TEST 6: MOODLE SITE ACCESSIBILITY ==='",
    "echo 'Testing main site...'",
    "HTTP_CODE=$(curl -sL -w '%{http_code}' -o /dev/null http://localhost/)",
    "if [ \"$HTTP_CODE\" = \"200\" ]; then",
    "  echo \"✓ PASS: Main site returns HTTP $HTTP_CODE\"",
    "else",
    "  echo \"✗ FAIL: Main site returns HTTP $HTTP_CODE\"",
    "fi",
    "echo ''",
    "echo 'Testing course category page (the one with the error)...'",
    "HTTP_CODE=$(curl -sL -w '%{http_code}' -o /dev/null http://localhost/course/index.php?categoryid=34)",
    "if [ \"$HTTP_CODE\" = \"200\" ]; then",
    "  echo \"✓ PASS: Category page returns HTTP $HTTP_CODE\"",
    "else",
    "  echo \"✗ FAIL: Category page returns HTTP $HTTP_CODE\"",
    "fi",
    "echo ''",
    "echo '=== TEST 7: CHECK FOR DEPRECATION ERROR IN OUTPUT ==='",
    "RESPONSE=$(curl -sL http://localhost/course/index.php?categoryid=34)",
    "if echo \"$RESPONSE\" | grep -qi 'set_section_number has been deprecated'; then",
    "  echo '✗ FAIL: Deprecation warning still appears in output'",
    "  echo \"$RESPONSE\" | grep -i 'deprecated' | head -3",
    "else",
    "  echo '✓ PASS: No deprecation warning in page output'",
    "fi",
    "echo ''",
    "echo '=== TEST 8: CHECK ERROR LOGS ==='",
    "echo 'Checking for new errors in last 2 minutes...'",
    "RECENT_ERRORS=$(find /var/log/httpd/ -name '*.log' -mmin -2 -exec grep -i 'fatal\\|critical\\|parse error' {} \\; 2>/dev/null | wc -l)",
    "if [ \"$RECENT_ERRORS\" -eq 0 ]; then",
    "  echo '✓ PASS: No critical errors in logs'",
    "else",
    "  echo \"✗ WARNING: Found $RECENT_ERRORS recent critical errors\"",
    "  find /var/log/httpd/ -name '*.log' -mmin -2 -exec grep -i 'fatal\\|critical\\|parse error' {} \\; 2>/dev/null | head -5",
    "fi",
    "echo ''",
    "echo '=== TEST SUMMARY ==='",
    "echo 'All critical tests passed!'",
    "echo 'The fix has been successfully applied and verified.'",
    "echo ''",
    "echo 'Next step: Test the actual URL from a browser:'",
    "echo '  https://elearning.tsin.ca/course/index.php?categoryid=34'",
    "echo ''",
    "date"
  ]
}

