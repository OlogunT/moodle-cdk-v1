{
  "commands": [
    "cd /app/moodle",
    "export REGION=ca-central-1",
    "export DB_ENDPOINT=moodlecdkstack-moodledatabase37183653-gxqtqhm9exgm.crx38jxk1vhe.ca-central-1.rds.amazonaws.com",
    "echo 'Discovering ALB URL and EFS IDs dynamically...'",
    "STACK_NAME=$(aws ec2 describe-tags --region \"$REGION\" --filters \"Name=resource-id,Values=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)\" \"Name=key,Values=aws:cloudformation:stack-name\" --query \"Tags[0].Value\" --output text 2>/dev/null || echo \"MoodleCdkStack\")",
    "echo \"Stack name: $STACK_NAME\"",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`MoodleUrl\\`].OutputValue\" --output text 2>/dev/null)",
    "DATA_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`DataEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "APP_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`AppEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
    "  echo 'Fallback: discovering ALB by name...'",
    "  ALB_ARN=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, \\`Moodle\\`)].LoadBalancerArn\" --output text 2>/dev/null | head -1)",
    "  if [ -n \"$ALB_ARN\" ]; then",
    "    ALB_DNS_NAME=$(aws elbv2 describe-load-balancers --region \"$REGION\" --load-balancer-arns \"$ALB_ARN\" --query \"LoadBalancers[0].DNSName\" --output text 2>/dev/null)",
    "    ALB_URL=\"http://$ALB_DNS_NAME\"",
    "  fi",
    "fi",
    "if [ -z \"$DATA_EFS_ID\" ] || [ \"$DATA_EFS_ID\" = \"None\" ]; then",
    "  echo 'Fallback: discovering EFS by tags...'",
    "  DATA_EFS_ID=$(aws efs describe-file-systems --region \"$REGION\" --query \"FileSystems[?Tags[?Key==\\`Name\\` && contains(Value, \\`Data\\`)]].FileSystemId\" --output text 2>/dev/null | head -1)",
    "fi",
    "if [ -z \"$APP_EFS_ID\" ] || [ \"$APP_EFS_ID\" = \"None\" ]; then",
    "  APP_EFS_ID=$(aws efs describe-file-systems --region \"$REGION\" --query \"FileSystems[?Tags[?Key==\\`Name\\` && contains(Value, \\`App\\`)]].FileSystemId\" --output text 2>/dev/null | head -1)",
    "fi",
    "echo \"ALB URL: $ALB_URL\"",
    "echo \"Data EFS ID: $DATA_EFS_ID\"",
    "echo \"App EFS ID: $APP_EFS_ID\"",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region ca-central-1 --query 'SecretList[?contains(Name, `MoodleDbSecret`)].ARN' --output text)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "echo 'Checking if Moodle is already installed...'",
    "if [ -f \"/app/moodle/config.php\" ]; then",
    "  echo 'Moodle config.php exists, checking database...'",
    "  if mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -D moodle -e \"SELECT COUNT(*) FROM mdl_config WHERE name='version';\" 2>/dev/null | grep -q \"1\"; then",
    "    echo 'Moodle is already installed!'",
    "    echo 'Updating wwwroot in config.php...'",
    "    sudo -u apache sed -i \"s|\\$CFG->wwwroot.*|\\$CFG->wwwroot = '$ALB_URL';|\" /app/moodle/config.php",
    "    echo 'Configuration updated!'",
    "  else",
    "    echo 'Database not initialized, removing config.php and reinstalling...'",
    "    rm -f /app/moodle/config.php",
    "    echo 'Installing Moodle via CLI...'",
    "    sudo -u apache php admin/cli/install.php --lang=en --wwwroot=\"$ALB_URL\" --dataroot=\"/data/moodledata\" --dbtype=mariadb --dbhost=\"$DB_ENDPOINT\" --dbname=moodle --dbuser=\"$DB_USER\" --dbpass=\"$DB_PASS\" --dbport=3306 --prefix=mdl_ --fullname=\"Touchstone Institute\" --shortname=\"TSI\" --adminuser=\"moodle-admin\" --adminpass=\"TempPass123!\" --adminemail=\"it@tsin.ca\" --non-interactive --agree-license",
    "    echo 'Installation completed!'",
    "  fi",
    "else",
    "  echo 'No config.php found, installing Moodle...'",
    "  sudo -u apache php admin/cli/install.php --lang=en --wwwroot=\"$ALB_URL\" --dataroot=\"/data/moodledata\" --dbtype=mariadb --dbhost=\"$DB_ENDPOINT\" --dbname=moodle --dbuser=\"$DB_USER\" --dbpass=\"$DB_PASS\" --dbport=3306 --prefix=mdl_ --fullname=\"Touchstone Institute\" --shortname=\"TSI\" --adminuser=\"moodle-admin\" --adminpass=\"TempPass123!\" --adminemail=\"it@tsin.ca\" --non-interactive --agree-license",
    "  echo 'Installation completed!'",
    "fi",
    "chown -R apache:apache /app/moodle /data/moodledata",
    "find /app/moodle -type f -exec chmod 644 {} \\;",
    "find /app/moodle -type d -exec chmod 755 {} \\;",
    "chmod -R 777 /data/moodledata",
    "systemctl restart httpd php-fpm",
    "echo 'Moodle installation completed successfully!'",
    "echo \"Access Moodle at: $ALB_URL\"",
    "echo 'Admin username: moodle-admin'",
    "echo 'Admin password: TempPass123! (change this immediately!)'"
  ]
}
