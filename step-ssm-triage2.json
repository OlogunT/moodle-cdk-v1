{
  "commands": [
    "set -euxo pipefail",
    "echo '=== TRIAGE: Moodle 500 investigation ==='",
    "date",
    "echo 'Hostname:' $(hostname)",
    "ls -l /app/moodle/health.php || true",
    "cat >/app/moodle/health.php <<'PHP'\n<?php\nhttp_response_code(200);\necho \"OK\";\n?>\nPHP",
    "chown apache:apache /app/moodle/health.php || true",
    "chmod 644 /app/moodle/health.php || true",
    "echo '--- Local health HEAD ---'",
    "curl -sI http://localhost/health.php | head -1 || true",
    "echo '--- Local login HEAD ---'",
    "curl -sI http://localhost/login/index.php | head -1 || true",
    "echo '--- httpd error_log tail ---'",
    "tail -n 80 /var/log/httpd/error_log || true",
    "echo '--- php-fpm www-error.log tail ---'",
    "tail -n 80 /var/log/php-fpm/www-error.log || true",
    "echo '--- Restart via moodle service ---'",
    "systemctl daemon-reload || true",
    "if systemctl list-unit-files | grep -q '^moodle.service'; then systemctl start moodle || true; else systemctl restart httpd php-fpm || true; fi",
    "sleep 5",
    "echo '--- Local health after restart ---'",
    "curl -sI http://localhost/health.php | head -1 || true",
    "echo '--- Local login after restart ---'",
    "curl -sI http://localhost/login/index.php | head -1 || true",
    "echo '=== TRIAGE DONE ==='"
  ]
}
