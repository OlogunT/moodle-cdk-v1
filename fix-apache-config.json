{
  "commands": [
    "echo 'Diagnosing Apache configuration...'",
    "systemctl status httpd --no-pager",
    "echo 'Checking Apache configuration files...'",
    "ls -la /etc/httpd/conf.d/",
    "echo 'Checking document root...'",
    "ls -la /app/moodle/",
    "echo 'Checking if index.php exists...'",
    "ls -la /app/moodle/index.php",
    "echo 'Testing local Apache access...'",
    "curl -I http://localhost/",
    "curl -I http://localhost/index.php",
    "echo 'Checking Apache error logs...'",
    "tail -10 /var/log/httpd/error_log",
    "echo 'Fixing Apache virtual host configuration...'",
    "cat > /etc/httpd/conf.d/moodle.conf << 'EOF'",
    "<VirtualHost *:80>",
    "    DocumentRoot /app/moodle",
    "    ServerName localhost",
    "    DirectoryIndex index.php index.html",
    "    ",
    "    <Directory /app/moodle>",
    "        Options -Indexes +FollowSymLinks",
    "        AllowOverride All",
    "        Require all granted",
    "    </Directory>",
    "    ",
    "    # Security headers",
    "    Header always set X-Content-Type-Options nosniff",
    "    Header always set X-Frame-Options DENY",
    "    Header always set X-XSS-Protection \"1; mode=block\"",
    "    ",
    "    # Logging",
    "    ErrorLog /var/log/httpd/moodle_error.log",
    "    CustomLog /var/log/httpd/moodle_access.log combined",
    "</VirtualHost>",
    "EOF",
    "echo 'Disabling default Apache site...'",
    "mv /etc/httpd/conf.d/welcome.conf /etc/httpd/conf.d/welcome.conf.disabled 2>/dev/null || echo 'Welcome.conf not found'",
    "echo 'Testing Apache configuration...'",
    "httpd -t",
    "echo 'Restarting Apache...'",
    "systemctl restart httpd",
    "systemctl status httpd --no-pager",
    "echo 'Testing local access after restart...'",
    "sleep 5",
    "curl -I http://localhost/",
    "curl -s http://localhost/ | head -20",
    "echo 'Apache configuration fixed!'"
  ]
}
