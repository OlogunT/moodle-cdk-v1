{
  "commands": [
    "echo 'Testing instance metadata service...'",
    "curl -s http://169.254.169.254/latest/meta-data/",
    "echo ''",
    "echo 'Testing region metadata...'",
    "curl -s http://169.254.169.254/latest/meta-data/placement/region",
    "echo ''",
    "echo 'Testing instance ID...'",
    "curl -s http://169.254.169.254/latest/meta-data/instance-id",
    "echo ''",
    "echo 'Testing AWS CLI...'",
    "aws sts get-caller-identity --region ca-central-1",
    "echo 'Testing CloudFormation access...'",
    "aws cloudformation list-stacks --region ca-central-1 --max-items 5",
    "echo 'Testing EC2 tags...'",
    "INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)",
    "echo \"Instance ID: $INSTANCE_ID\"",
    "aws ec2 describe-tags --region ca-central-1 --filters \"Name=resource-id,Values=$INSTANCE_ID\" --query \"Tags[*].[Key,Value]\" --output table"
  ]
}
