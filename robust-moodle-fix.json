{
  "Parameters": {
    "commands": [
      "echo '=== ROBUST MOODLE CONFIGURATION ==='",
      "cd /app/moodle",
      "echo '--- Set region with fallback ---'",
      "REGION=$(curl -s http://169.254.169.254/latest/meta-data/placement/region 2>/dev/null || echo 'ca-central-1')",
      "if [ -z \"$REGION\" ]; then REGION='ca-central-1'; fi",
      "echo \"Region: $REGION\"",
      "echo '--- Try multiple methods to get DB endpoint ---'",
      "DB_ENDPOINT=''",
      "echo 'Method 1: CloudFormation...'",
      "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text 2>/dev/null || echo '')",
      "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
      "  echo 'Method 2: RDS discovery...'",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[0].Endpoint.Address\" --output text 2>/dev/null || echo '')",
      "fi",
      "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
      "  echo 'Method 3: RDS with filter...'",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[?contains(DBInstanceIdentifier, 'moodle')].Endpoint.Address\" --output text 2>/dev/null | head -1 || echo '')",
      "fi",
      "echo \"DB Endpoint: $DB_ENDPOINT\"",
      "echo '--- Try multiple methods to get DB secret ---'",
      "DB_SECRET_ARN=''",
      "echo 'Method 1: CloudFormation...'",
      "DB_SECRET_ARN=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='DatabaseSecretArn'].OutputValue\" --output text 2>/dev/null || echo '')",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Method 2: Secrets with Moodle filter...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'Moodle')].ARN\" --output text 2>/dev/null | head -1 || echo '')",
      "fi",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Method 3: Secrets with Db filter...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'Db')].ARN\" --output text 2>/dev/null | head -1 || echo '')",
      "fi",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Method 4: First available secret...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[0].ARN\" --output text 2>/dev/null || echo '')",
      "fi",
      "echo \"DB Secret ARN: $DB_SECRET_ARN\"",
      "echo '--- Get database credentials ---'",
      "if [ -n \"$DB_SECRET_ARN\" ] && [ \"$DB_SECRET_ARN\" != \"None\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region \"$REGION\" --secret-id \"$DB_SECRET_ARN\" --query SecretString --output text 2>/dev/null || echo '')",
      "  if [ -n \"$DB_CREDS\" ]; then",
      "    DB_USER=$(echo \"$DB_CREDS\" | jq -r .username 2>/dev/null || echo '')",
      "    DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password 2>/dev/null || echo '')",
      "    DB_NAME=$(echo \"$DB_CREDS\" | jq -r .dbname 2>/dev/null || echo 'moodle')",
      "  fi",
      "fi",
      "echo \"DB User: $DB_USER\"",
      "echo \"DB Name: $DB_NAME\"",
      "echo '--- Try multiple methods to get ALB URL ---'",
      "ALB_URL=''",
      "echo 'Method 1: CloudFormation...'",
      "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text 2>/dev/null || echo '')",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
      "  echo 'Method 2: ALB discovery...'",
      "  ALB_DNS=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, 'Moodle')].DNSName\" --output text 2>/dev/null | head -1 || echo '')",
      "  if [ -n \"$ALB_DNS\" ]; then",
      "    ALB_URL=\"http://$ALB_DNS\"",
      "  fi",
      "fi",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ] || [ \"$ALB_URL\" = \"http://\" ]; then",
      "  echo 'Method 3: Instance public hostname...'",
      "  PUBLIC_HOSTNAME=$(curl -s http://169.254.169.254/latest/meta-data/public-hostname 2>/dev/null || echo '')",
      "  if [ -n \"$PUBLIC_HOSTNAME\" ]; then",
      "    ALB_URL=\"http://$PUBLIC_HOSTNAME\"",
      "  fi",
      "fi",
      "echo \"ALB URL: $ALB_URL\"",
      "echo '--- Check if we have minimum required info ---'",
      "if [ -z \"$DB_ENDPOINT\" ] || [ -z \"$DB_USER\" ] || [ -z \"$DB_PASS\" ]; then",
      "  echo 'WARNING: Missing database info, trying to create basic config anyway...'",
      "  echo 'Using fallback database values for testing...'",
      "  if [ -z \"$DB_ENDPOINT\" ]; then DB_ENDPOINT='localhost'; fi",
      "  if [ -z \"$DB_USER\" ]; then DB_USER='moodleuser'; fi",
      "  if [ -z \"$DB_PASS\" ]; then DB_PASS='defaultpass'; fi",
      "  if [ -z \"$DB_NAME\" ]; then DB_NAME='moodle'; fi",
      "fi",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"http://\" ]; then",
      "  echo 'WARNING: No ALB URL found, using localhost...'",
      "  ALB_URL='http://localhost'",
      "fi",
      "echo '--- Create config.php ---'",
      "cat > /app/moodle/config.php << EOF",
      "<?php",
      "unset(\\$CFG);",
      "global \\$CFG;",
      "\\$CFG = new stdClass();",
      "",
      "\\$CFG->dbtype    = 'mariadb';",
      "\\$CFG->dblibrary = 'native';",
      "\\$CFG->dbhost    = '$DB_ENDPOINT';",
      "\\$CFG->dbname    = '$DB_NAME';",
      "\\$CFG->dbuser    = '$DB_USER';",
      "\\$CFG->dbpass    = '$DB_PASS';",
      "\\$CFG->prefix    = 'mdl_';",
      "\\$CFG->dboptions = array (",
      "  'dbpersist' => 0,",
      "  'dbport' => 3306,",
      "  'dbsocket' => '',",
      "  'dbcollation' => 'utf8mb4_unicode_ci',",
      ");",
      "",
      "\\$CFG->wwwroot   = '$ALB_URL';",
      "\\$CFG->dataroot  = '/data/moodledata';",
      "\\$CFG->admin     = 'admin';",
      "",
      "\\$CFG->directorypermissions = 0777;",
      "",
      "require_once(__DIR__ . '/lib/setup.php');",
      "EOF",
      "echo '--- Set permissions ---'",
      "chown apache:apache /app/moodle/config.php",
      "chmod 644 /app/moodle/config.php",
      "mkdir -p /data/moodledata",
      "chown -R apache:apache /data/moodledata",
      "chmod -R 777 /data/moodledata",
      "echo '--- Create health check ---'",
      "cat > /app/moodle/health.php << 'EOF'",
      "<?php",
      "http_response_code(200);",
      "echo 'OK';",
      "?>",
      "EOF",
      "chown apache:apache /app/moodle/health.php",
      "echo '--- Test web access ---'",
      "curl -sI http://localhost/ | head -3",
      "curl -sI http://localhost/health.php | head -3",
      "echo '--- Show final config for debugging ---'",
      "echo 'Final configuration values:'",
      "echo \"  DB_ENDPOINT: $DB_ENDPOINT\"",
      "echo \"  DB_USER: $DB_USER\"",
      "echo \"  DB_NAME: $DB_NAME\"",
      "echo \"  ALB_URL: $ALB_URL\"",
      "echo '=== ROBUST CONFIGURATION COMPLETE ==='"
    ]
  }
}
