{
  "commands": [
    "echo '=== Testing Dynamic Parameter Discovery ==='",
    "echo 'Testing all dynamic discovery mechanisms...'",
    "",
    "# Test 1: Region discovery",
    "echo '1. Testing region discovery...'",
    "REGION=$(curl -s http://169.254.169.254/latest/meta-data/placement/region)",
    "echo \"Region: $REGION\"",
    "",
    "# Test 2: Stack name discovery",
    "echo '2. Testing stack name discovery...'",
    "STACK_NAME=$(aws ec2 describe-tags --region \"$REGION\" --filters \"Name=resource-id,Values=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)\" \"Name=key,Values=aws:cloudformation:stack-name\" --query \"Tags[0].Value\" --output text 2>/dev/null)",
    "if [ -z \"$STACK_NAME\" ] || [ \"$STACK_NAME\" = \"None\" ]; then",
    "  echo 'Warning: Could not determine stack name from tags, using default'",
    "  STACK_NAME=\"MoodleCdkStack\"",
    "fi",
    "echo \"Stack name: $STACK_NAME\"",
    "",
    "# Test 3: Database endpoint discovery",
    "echo '3. Testing database endpoint discovery...'",
    "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`DatabaseEndpoint\\`].OutputValue\" --output text 2>/dev/null)",
    "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
    "  echo 'CloudFormation outputs not available, discovering database by tags...'",
    "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[?contains(DBInstanceIdentifier, \\`moodle\\`) || contains(DBInstanceIdentifier, \\`${STACK_NAME,,}\\`)].Endpoint.Address\" --output text 2>/dev/null | head -1)",
    "fi",
    "echo \"Database endpoint: $DB_ENDPOINT\"",
    "",
    "# Test 4: Database secret ARN discovery",
    "echo '4. Testing database secret ARN discovery...'",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, \\`MoodleDbSecret\\`) || contains(Name, \\`${STACK_NAME}\\`)].ARN\" --output text | head -1)",
    "echo \"Database secret ARN: $DB_SECRET_ARN\"",
    "",
    "# Test 5: EFS discovery",
    "echo '5. Testing EFS discovery...'",
    "DATA_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`DataEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "APP_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`AppEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "if [ -z \"$DATA_EFS_ID\" ] || [ \"$DATA_EFS_ID\" = \"None\" ]; then",
    "  echo 'CloudFormation outputs not available, discovering EFS by tags...'",
    "  DATA_EFS_ID=$(aws efs describe-file-systems --region \"$REGION\" --query \"FileSystems[?Tags[?Key==\\`Name\\` && contains(Value, \\`Data\\`)]].FileSystemId\" --output text 2>/dev/null | head -1)",
    "fi",
    "if [ -z \"$APP_EFS_ID\" ] || [ \"$APP_EFS_ID\" = \"None\" ]; then",
    "  APP_EFS_ID=$(aws efs describe-file-systems --region \"$REGION\" --query \"FileSystems[?Tags[?Key==\\`Name\\` && contains(Value, \\`App\\`)]].FileSystemId\" --output text 2>/dev/null | head -1)",
    "fi",
    "echo \"Data EFS ID: $DATA_EFS_ID\"",
    "echo \"App EFS ID: $APP_EFS_ID\"",
    "",
    "# Test 6: ALB URL discovery",
    "echo '6. Testing ALB URL discovery...'",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`MoodleUrl\\`].OutputValue\" --output text 2>/dev/null)",
    "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
    "  echo 'CloudFormation outputs not available, discovering ALB by name...'",
    "  ALB_ARN=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, \\`Moodle\\`)].LoadBalancerArn\" --output text 2>/dev/null | head -1)",
    "  if [ -n \"$ALB_ARN\" ]; then",
    "    ALB_DNS_NAME=$(aws elbv2 describe-load-balancers --region \"$REGION\" --load-balancer-arns \"$ALB_ARN\" --query \"LoadBalancers[0].DNSName\" --output text 2>/dev/null)",
    "    ALB_URL=\"http://$ALB_DNS_NAME\"",
    "  fi",
    "fi",
    "echo \"ALB URL: $ALB_URL\"",
    "",
    "# Test 7: Database connectivity",
    "echo '7. Testing database connectivity...'",
    "if [ -n \"$DB_ENDPOINT\" ] && [ -n \"$DB_SECRET_ARN\" ]; then",
    "  DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text 2>/dev/null)",
    "  if [ -n \"$DB_CREDS\" ]; then",
    "    DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "    DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "    echo \"Database user: $DB_USER\"",
    "    if mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -e \"SELECT 1;\" 2>/dev/null; then",
    "      echo '✓ Database connection successful'",
    "    else",
    "      echo '✗ Database connection failed'",
    "    fi",
    "  else",
    "    echo '✗ Could not retrieve database credentials'",
    "  fi",
    "else",
    "  echo '✗ Database endpoint or secret ARN not found'",
    "fi",
    "",
    "# Test 8: EFS connectivity",
    "echo '8. Testing EFS connectivity...'",
    "if [ -n \"$DATA_EFS_ID\" ] && [ -n \"$APP_EFS_ID\" ]; then",
    "  DATA_EFS_DNS=\"$DATA_EFS_ID.efs.$REGION.amazonaws.com\"",
    "  APP_EFS_DNS=\"$APP_EFS_ID.efs.$REGION.amazonaws.com\"",
    "  echo \"Data EFS DNS: $DATA_EFS_DNS\"",
    "  echo \"App EFS DNS: $APP_EFS_DNS\"",
    "  if mountpoint -q /data && mountpoint -q /app; then",
    "    echo '✓ EFS file systems are mounted'",
    "    df -h | grep efs",
    "  else",
    "    echo '✗ EFS file systems are not mounted'",
    "  fi",
    "else",
    "  echo '✗ EFS IDs not found'",
    "fi",
    "",
    "# Test 9: ALB accessibility",
    "echo '9. Testing ALB accessibility...'",
    "if [ -n \"$ALB_URL\" ]; then",
    "  if curl -s -o /dev/null -w \"%{http_code}\" \"$ALB_URL\" | grep -q \"200\\|302\\|404\"; then",
    "    echo '✓ ALB is accessible'",
    "  else",
    "    echo '✗ ALB is not accessible'",
    "  fi",
    "else",
    "  echo '✗ ALB URL not found'",
    "fi",
    "",
    "echo '=== Dynamic Discovery Test Complete ==='",
    "echo 'Summary:'",
    "echo \"Region: $REGION\"",
    "echo \"Stack: $STACK_NAME\"",
    "echo \"Database: $DB_ENDPOINT\"",
    "echo \"Secret: $DB_SECRET_ARN\"",
    "echo \"Data EFS: $DATA_EFS_ID\"",
    "echo \"App EFS: $APP_EFS_ID\"",
    "echo \"ALB URL: $ALB_URL\""
  ]
}
