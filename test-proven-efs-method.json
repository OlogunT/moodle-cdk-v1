{
  "commands": [
    "echo '=== Testing Proven EFS Mount Method ==='",
    "echo 'Using the exact method that works from your snippet'",
    "set -e",
    "APP_EFS_ID='fs-0c60c5879a0dcecb1'",
    "DATA_EFS_ID='fs-075a2be536c08840c'",
    "AWS_REGION='ca-central-1'",
    "echo '💾 Setting up EFS file systems...'",
    "mkdir -p /mnt/efs/app /mnt/efs/data",
    "if [ -n \"$APP_EFS_ID\" ] && [ -n \"$DATA_EFS_ID\" ]; then",
    "  echo '📁 Mounting EFS file systems...'",
    "  echo \"${APP_EFS_ID}.efs.${AWS_REGION}.amazonaws.com:/ /mnt/efs/app nfs4 nfsvers=4.1,rsize=1048576,wsize=1048576,hard,intr,timeo=600,retrans=2 0 0\" >> /etc/fstab",
    "  echo \"${DATA_EFS_ID}.efs.${AWS_REGION}.amazonaws.com:/ /mnt/efs/data nfs4 nfsvers=4.1,rsize=1048576,wsize=1048576,hard,intr,timeo=600,retrans=2 0 0\" >> /etc/fstab",
    "  mount -a",
    "  echo '🔐 Setting proper EFS permissions...'",
    "  chown -R apache:apache /mnt/efs/app /mnt/efs/data",
    "  chmod -R 755 /mnt/efs/app",
    "  chmod -R 777 /mnt/efs/data",
    "  mkdir -p /mnt/efs/data/moodledata",
    "  chown -R apache:apache /mnt/efs/data/moodledata",
    "  chmod -R 777 /mnt/efs/data/moodledata",
    "  mkdir -p /mnt/efs",
    "  chown apache:apache /mnt/efs",
    "  chmod 755 /mnt/efs",
    "  ln -sf /mnt/efs/data/moodledata /mnt/efs/moodledata",
    "  rm -rf /var/www/html",
    "  ln -sf /mnt/efs/app /var/www/html",
    "  echo '✓ EFS setup complete'",
    "else",
    "  echo '❌ EFS IDs not provided, skipping EFS setup'",
    "  exit 1",
    "fi",
    "echo '=== Verification ==='",
    "df -h | grep efs && echo '✓ EFS mounted'",
    "ls -la /mnt/efs/app && echo '✓ App EFS accessible'",
    "ls -la /mnt/efs/data && echo '✓ Data EFS accessible'",
    "ls -la /var/www/html && echo '✓ Symlink created'",
    "echo '=== Test Complete ==='",
    "echo 'EFS mount test using proven method completed successfully!'"
  ]
}
