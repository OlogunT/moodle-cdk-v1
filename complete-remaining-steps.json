{
  "commands": [
    "echo '=== Completing Remaining Moodle Installation Steps ==='",
    "echo 'Current status check:'",
    "df -h | grep efs && echo 'EFS: Mounted' || echo 'EFS: Not mounted'",
    "ls -la /app/moodle/index.php && echo 'Moodle: Downloaded' || echo 'Moodle: Missing'",
    "systemctl is-active httpd && echo 'Apache: Active' || echo 'Apache: Inactive'",
    "systemctl is-active php-fpm && echo 'PHP-FPM: Active' || echo 'PHP-FPM: Inactive'",
    "echo ''",
    "echo '=== Step 1: Configure Apache Virtual Host ==='",
    "cat > /etc/httpd/conf.d/moodle.conf << 'EOF'",
    "<VirtualHost *:80>",
    "    DocumentRoot /app/moodle",
    "    ServerName localhost",
    "    DirectoryIndex index.php index.html",
    "    <Directory /app/moodle>",
    "        Options -Indexes +FollowSymLinks",
    "        AllowOverride All",
    "        Require all granted",
    "    </Directory>",
    "    ErrorLog /var/log/httpd/moodle_error.log",
    "    CustomLog /var/log/httpd/moodle_access.log combined",
    "</VirtualHost>",
    "EOF",
    "echo 'Apache virtual host configured'",
    "mv /etc/httpd/conf.d/welcome.conf /etc/httpd/conf.d/welcome.conf.disabled 2>/dev/null || echo 'Welcome page already disabled'",
    "echo ''",
    "echo '=== Step 2: Get Database Credentials ==='",
    "TOKEN=$(curl -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s)",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'MoodleDbSecret')].ARN\" --output text | head -1)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text)",
    "echo \"Database endpoint: $DB_ENDPOINT\"",
    "echo \"Database user: $DB_USER\"",
    "echo 'Testing database connection...'",
    "mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -e 'SELECT 1;' && echo 'Database connection: OK' || echo 'Database connection: FAILED'",
    "echo ''",
    "echo '=== Step 3: Get ALB URL ==='",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text)",
    "echo \"ALB URL: $ALB_URL\"",
    "echo ''",
    "echo '=== Step 4: Prepare Moodle Data Directory ==='",
    "mkdir -p /data/moodledata",
    "chown apache:apache /data/moodledata",
    "chmod 777 /data/moodledata",
    "ls -la /data/ && echo 'Moodle data directory prepared'",
    "echo ''",
    "echo '=== Step 5: Restart Apache to Load New Config ==='",
    "systemctl restart httpd php-fpm",
    "sleep 3",
    "systemctl status httpd --no-pager -l",
    "echo 'Testing Apache after restart...'",
    "curl -I http://localhost/ 2>/dev/null | head -1 || echo 'Apache test failed'",
    "echo ''",
    "echo '=== Step 6: Run Moodle CLI Installation ==='",
    "cd /app/moodle",
    "if [ ! -f 'config.php' ]; then",
    "  echo 'Running Moodle CLI installation...'",
    "  sudo -u apache php admin/cli/install.php --lang=en --wwwroot=\"$ALB_URL\" --dataroot=/data/moodledata --dbtype=mariadb --dbhost=\"$DB_ENDPOINT\" --dbname=moodle --dbuser=\"$DB_USER\" --dbpass=\"$DB_PASS\" --dbport=3306 --prefix=mdl_ --fullname='Touchstone Institute' --shortname=TSI --adminuser=moodle-admin --adminpass='TempPass123!' --adminemail='it@tsin.ca' --non-interactive --agree-license",
    "  echo 'Moodle CLI installation completed'",
    "else",
    "  echo 'Moodle config.php already exists, updating wwwroot...'",
    "  sudo -u apache sed -i \"s|\\$CFG->wwwroot.*|\\$CFG->wwwroot = '$ALB_URL';|\" config.php",
    "  echo 'Moodle configuration updated'",
    "fi",
    "echo ''",
    "echo '=== Step 7: Create Health Check Endpoint ==='",
    "cat > /app/moodle/health.php << 'EOF'",
    "<?php",
    "http_response_code(200);",
    "echo 'OK';",
    "?>",
    "EOF",
    "chown apache:apache /app/moodle/health.php",
    "chmod 644 /app/moodle/health.php",
    "echo 'Health check endpoint created'",
    "echo ''",
    "echo '=== Step 8: Set Final Permissions ==='",
    "chown -R apache:apache /app/moodle /data/moodledata",
    "find /app/moodle -type f -exec chmod 644 {} \\;",
    "find /app/moodle -type d -exec chmod 755 {} \\;",
    "chmod -R 777 /data/moodledata",
    "echo 'Permissions set'",
    "echo ''",
    "echo '=== Step 9: Final Service Restart ==='",
    "systemctl restart httpd php-fpm",
    "sleep 5",
    "echo 'Services restarted'",
    "echo ''",
    "echo '=== Step 10: Comprehensive Testing ==='",
    "echo 'Testing health endpoint...'",
    "curl -f http://localhost/health.php && echo 'Health endpoint: OK' || echo 'Health endpoint: FAILED'",
    "echo ''",
    "echo 'Testing Moodle index page...'",
    "curl -f http://localhost/index.php >/dev/null 2>&1 && echo 'Moodle index: OK' || echo 'Moodle index: FAILED'",
    "echo ''",
    "echo 'Testing Moodle login page...'",
    "curl -f http://localhost/login/index.php >/dev/null 2>&1 && echo 'Moodle login: OK' || echo 'Moodle login: FAILED'",
    "echo ''",
    "echo 'Testing main Moodle page...'",
    "curl -f http://localhost/ >/dev/null 2>&1 && echo 'Moodle main page: OK' || echo 'Moodle main page: FAILED'",
    "echo ''",
    "echo '=== Installation Summary ==='",
    "echo 'Moodle Installation Complete!'",
    "echo \"Access URL: $ALB_URL\"",
    "echo 'Admin Username: moodle-admin'",
    "echo 'Admin Password: TempPass123!'",
    "echo 'Admin Email: it@tsin.ca'",
    "echo ''",
    "echo 'System Status:'",
    "df -h | grep efs",
    "systemctl is-active httpd && echo 'Apache: Running'",
    "systemctl is-active php-fpm && echo 'PHP-FPM: Running'",
    "ls -la /app/moodle/config.php 2>/dev/null && echo 'Moodle: Configured' || echo 'Moodle: Not configured'",
    "echo ''",
    "echo 'IMPORTANT: Change admin password after first login!'"
  ]
}
