{
  "Parameters": {
    "commands": [
      "echo '=== CREATING MOODLE CONFIG MANUALLY ==='",
      "cd /app/moodle",
      "echo '--- Create basic config.php ---'",
      "cat > /app/moodle/config.php << 'EOF'",
      "<?php",
      "unset($CFG);",
      "global $CFG;",
      "$CFG = new stdClass();",
      "",
      "$CFG->dbtype    = 'mariadb';",
      "$CFG->dblibrary = 'native';",
      "$CFG->dbhost    = 'moodlecdkstack-moodledatabase-wnqhqhqhqhqh.cluster-c9z9z9z9z9z9.ca-central-1.rds.amazonaws.com';",
      "$CFG->dbname    = 'moodle';",
      "$CFG->dbuser    = 'admin';",
      "$CFG->dbpass    = 'password123';",
      "$CFG->prefix    = 'mdl_';",
      "$CFG->dboptions = array (",
      "  'dbpersist' => 0,",
      "  'dbport' => 3306,",
      "  'dbsocket' => '',",
      "  'dbcollation' => 'utf8mb4_unicode_ci',",
      ");",
      "",
      "$CFG->wwwroot   = 'http://moodle-moodl-3wp8ysl2xtuu-1534359783.ca-central-1.elb.amazonaws.com';",
      "$CFG->dataroot  = '/data/moodledata';",
      "$CFG->admin     = 'admin';",
      "",
      "$CFG->directorypermissions = 0777;",
      "",
      "require_once(__DIR__ . '/lib/setup.php');",
      "",
      "// There is no php closing tag in this file,",
      "// it is intentional because it prevents trailing whitespace problems!",
      "EOF",
      "echo '--- Get actual DB endpoint ---'",
      "REGION='ca-central-1'",
      "DB_ENDPOINT=$(aws rds describe-db-instances --region $REGION --query \"DBInstances[0].Endpoint.Address\" --output text 2>/dev/null || echo 'localhost')",
      "echo \"Found DB endpoint: $DB_ENDPOINT\"",
      "echo '--- Get actual DB credentials ---'",
      "SECRET_ARN=$(aws secretsmanager list-secrets --region $REGION --query \"SecretList[0].ARN\" --output text 2>/dev/null)",
      "if [ -n \"$SECRET_ARN\" ] && [ \"$SECRET_ARN\" != \"None\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region $REGION --secret-id \"$SECRET_ARN\" --query SecretString --output text 2>/dev/null)",
      "  DB_USER=$(echo \"$DB_CREDS\" | jq -r .username 2>/dev/null || echo 'admin')",
      "  DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password 2>/dev/null || echo 'password123')",
      "else",
      "  DB_USER='admin'",
      "  DB_PASS='password123'",
      "fi",
      "echo \"Using DB_USER: $DB_USER\"",
      "echo '--- Update config with real values ---'",
      "sed -i \"s|dbhost.*=.*|dbhost    = '$DB_ENDPOINT';|\" /app/moodle/config.php",
      "sed -i \"s|dbuser.*=.*|dbuser    = '$DB_USER';|\" /app/moodle/config.php",
      "sed -i \"s|dbpass.*=.*|dbpass    = '$DB_PASS';|\" /app/moodle/config.php",
      "echo '--- Set permissions ---'",
      "chown apache:apache /app/moodle/config.php",
      "chmod 644 /app/moodle/config.php",
      "mkdir -p /data/moodledata",
      "chown -R apache:apache /data/moodledata",
      "chmod -R 777 /data/moodledata",
      "echo '--- Show final config ---'",
      "cat /app/moodle/config.php",
      "echo '--- Test database connection ---'",
      "sudo -u apache php -r \"",
      "require_once('/app/moodle/config.php');",
      "try {",
      "  \\$pdo = new PDO('mysql:host='.$CFG->dbhost.';port=3306;dbname='.$CFG->dbname, $CFG->dbuser, $CFG->dbpass);",
      "  echo 'Database connection: SUCCESS\\n';",
      "} catch (Exception \\$e) {",
      "  echo 'Database connection: FAILED - ' . \\$e->getMessage() . '\\n';",
      "}",
      "\"",
      "echo '--- Test web access ---'",
      "curl -sI http://localhost/ | head -3",
      "echo '=== CONFIG CREATION COMPLETE ==='"
    ]
  }
}
