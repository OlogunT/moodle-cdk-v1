{
  "Parameters": {
    "commands": [
      "echo '=== DYNAMIC MOODLE CONFIGURATION ==='",
      "cd /app/moodle",
      "echo '--- Discover region ---'",
      "REGION=$(curl -s http://169.254.169.254/latest/meta-data/placement/region)",
      "echo \"Region: $REGION\"",
      "echo '--- Discover stack name from instance tags ---'",
      "INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)",
      "STACK_NAME=$(aws ec2 describe-tags --region \"$REGION\" --filters \"Name=resource-id,Values=$INSTANCE_ID\" \"Name=key,Values=aws:cloudformation:stack-name\" --query \"Tags[0].Value\" --output text 2>/dev/null || echo 'MoodleCdkStack')",
      "echo \"Stack name: $STACK_NAME\"",
      "echo '--- Get database endpoint dynamically ---'",
      "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text 2>/dev/null)",
      "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
      "  echo 'Trying RDS discovery...'",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[0].Endpoint.Address\" --output text 2>/dev/null)",
      "fi",
      "echo \"DB Endpoint: $DB_ENDPOINT\"",
      "echo '--- Get database secret dynamically ---'",
      "DB_SECRET_ARN=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='DatabaseSecretArn'].OutputValue\" --output text 2>/dev/null)",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Trying secrets discovery...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'Db') || contains(Name, 'DB') || contains(Name, 'database')].ARN\" --output text 2>/dev/null | head -1)",
      "fi",
      "echo \"DB Secret ARN: $DB_SECRET_ARN\"",
      "echo '--- Get database credentials ---'",
      "if [ -n \"$DB_SECRET_ARN\" ] && [ \"$DB_SECRET_ARN\" != \"None\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region \"$REGION\" --secret-id \"$DB_SECRET_ARN\" --query SecretString --output text 2>/dev/null)",
      "  DB_USER=$(echo \"$DB_CREDS\" | jq -r .username 2>/dev/null)",
      "  DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password 2>/dev/null)",
      "  DB_NAME=$(echo \"$DB_CREDS\" | jq -r .dbname 2>/dev/null || echo 'moodle')",
      "else",
      "  echo 'ERROR: No database secret found'",
      "  exit 1",
      "fi",
      "echo \"DB User: $DB_USER\"",
      "echo \"DB Name: $DB_NAME\"",
      "echo '--- Get ALB URL dynamically ---'",
      "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text 2>/dev/null)",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
      "  echo 'Trying ALB discovery...'",
      "  ALB_DNS=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, 'Moodle') || contains(LoadBalancerName, 'moodle')].DNSName\" --output text 2>/dev/null | head -1)",
      "  if [ -n \"$ALB_DNS\" ]; then",
      "    ALB_URL=\"http://$ALB_DNS\"",
      "  else",
      "    ALB_URL=\"http://$(curl -s http://169.254.169.254/latest/meta-data/public-hostname)\"",
      "  fi",
      "fi",
      "echo \"ALB URL: $ALB_URL\"",
      "echo '--- Validate all parameters ---'",
      "if [ -z \"$DB_ENDPOINT\" ] || [ -z \"$DB_USER\" ] || [ -z \"$DB_PASS\" ] || [ -z \"$ALB_URL\" ]; then",
      "  echo 'ERROR: Missing required parameters:'",
      "  echo \"  DB_ENDPOINT: $DB_ENDPOINT\"",
      "  echo \"  DB_USER: $DB_USER\"",
      "  echo \"  ALB_URL: $ALB_URL\"",
      "  exit 1",
      "fi",
      "echo '--- Remove any existing config ---'",
      "rm -f /app/moodle/config.php",
      "echo '--- Create dynamic config.php ---'",
      "cat > /app/moodle/config.php << EOF",
      "<?php",
      "unset(\\$CFG);",
      "global \\$CFG;",
      "\\$CFG = new stdClass();",
      "",
      "\\$CFG->dbtype    = 'mariadb';",
      "\\$CFG->dblibrary = 'native';",
      "\\$CFG->dbhost    = '$DB_ENDPOINT';",
      "\\$CFG->dbname    = '$DB_NAME';",
      "\\$CFG->dbuser    = '$DB_USER';",
      "\\$CFG->dbpass    = '$DB_PASS';",
      "\\$CFG->prefix    = 'mdl_';",
      "\\$CFG->dboptions = array (",
      "  'dbpersist' => 0,",
      "  'dbport' => 3306,",
      "  'dbsocket' => '',",
      "  'dbcollation' => 'utf8mb4_unicode_ci',",
      ");",
      "",
      "\\$CFG->wwwroot   = '$ALB_URL';",
      "\\$CFG->dataroot  = '/data/moodledata';",
      "\\$CFG->admin     = 'admin';",
      "",
      "\\$CFG->directorypermissions = 0777;",
      "",
      "require_once(__DIR__ . '/lib/setup.php');",
      "EOF",
      "echo '--- Set permissions ---'",
      "chown apache:apache /app/moodle/config.php",
      "chmod 644 /app/moodle/config.php",
      "mkdir -p /data/moodledata",
      "chown -R apache:apache /data/moodledata",
      "chmod -R 777 /data/moodledata",
      "echo '--- Test database connection ---'",
      "sudo -u apache php -r \"",
      "require_once('/app/moodle/config.php');",
      "try {",
      "  \\$pdo = new PDO('mysql:host='.$CFG->dbhost.';port=3306;dbname='.$CFG->dbname, $CFG->dbuser, $CFG->dbpass);",
      "  echo 'Database connection: SUCCESS\\n';",
      "} catch (Exception \\$e) {",
      "  echo 'Database connection: FAILED - ' . \\$e->getMessage() . '\\n';",
      "  exit 1;",
      "}",
      "\"",
      "echo '--- Install Moodle via CLI ---'",
      "sudo -u apache php admin/cli/install.php \\",
      "  --lang=en \\",
      "  --wwwroot=\"$ALB_URL\" \\",
      "  --dataroot=\"/data/moodledata\" \\",
      "  --dbtype=mariadb \\",
      "  --dbhost=\"$DB_ENDPOINT\" \\",
      "  --dbname=\"$DB_NAME\" \\",
      "  --dbuser=\"$DB_USER\" \\",
      "  --dbpass=\"$DB_PASS\" \\",
      "  --dbport=3306 \\",
      "  --prefix=mdl_ \\",
      "  --fullname=\"Touchstone Institute\" \\",
      "  --shortname=\"TSI\" \\",
      "  --adminuser=\"moodle-admin\" \\",
      "  --adminpass=\"TempPass123!\" \\",
      "  --adminemail=\"it@tsin.ca\" \\",
      "  --non-interactive \\",
      "  --agree-license || echo 'Installation completed or already exists'",
      "echo '--- Create health check ---'",
      "cat > /app/moodle/health.php << 'EOF'",
      "<?php",
      "http_response_code(200);",
      "echo 'OK';",
      "?>",
      "EOF",
      "chown apache:apache /app/moodle/health.php",
      "echo '--- Final test ---'",
      "curl -sI http://localhost/ | head -3",
      "curl -sI http://localhost/health.php | head -3",
      "echo '=== DYNAMIC CONFIGURATION COMPLETE ==='"
    ]
  }
}
