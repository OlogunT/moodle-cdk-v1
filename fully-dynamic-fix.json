{
  "Parameters": {
    "commands": [
      "echo '=== FULLY DYNAMIC MOODLE FIX ==='",
      "cd /app/moodle",
      "echo '--- Discover region dynamically ---'",
      "REGION=$(curl -s http://169.254.169.254/latest/meta-data/placement/region 2>/dev/null || echo 'ca-central-1')",
      "if [ -z \"$REGION\" ]; then REGION='ca-central-1'; fi",
      "echo \"Region: $REGION\"",
      "echo '--- Discover stack name from instance tags ---'",
      "INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null)",
      "STACK_NAME=$(aws ec2 describe-tags --region \"$REGION\" --filters \"Name=resource-id,Values=$INSTANCE_ID\" \"Name=key,Values=aws:cloudformation:stack-name\" --query \"Tags[0].Value\" --output text 2>/dev/null || echo 'MoodleCdkStack')",
      "echo \"Stack name: $STACK_NAME\"",
      "echo '--- Dynamically discover ALB URL ---'",
      "ALB_URL=''",
      "echo 'Method 1: CloudFormation outputs...'",
      "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text 2>/dev/null || echo '')",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
      "  echo 'Method 2: ALB discovery by name pattern...'",
      "  ALB_DNS=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, 'Moodle') || contains(LoadBalancerName, 'moodle')].DNSName\" --output text 2>/dev/null | head -1 || echo '')",
      "  if [ -n \"$ALB_DNS\" ]; then",
      "    ALB_URL=\"http://$ALB_DNS\"",
      "  fi",
      "fi",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ] || [ \"$ALB_URL\" = \"http://\" ]; then",
      "  echo 'Method 3: First available ALB...'",
      "  ALB_DNS=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[0].DNSName\" --output text 2>/dev/null || echo '')",
      "  if [ -n \"$ALB_DNS\" ] && [ \"$ALB_DNS\" != \"None\" ]; then",
      "    ALB_URL=\"http://$ALB_DNS\"",
      "  fi",
      "fi",
      "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"http://\" ]; then",
      "  echo 'Method 4: Instance public hostname fallback...'",
      "  PUBLIC_HOSTNAME=$(curl -s http://169.254.169.254/latest/meta-data/public-hostname 2>/dev/null || echo '')",
      "  if [ -n \"$PUBLIC_HOSTNAME\" ]; then",
      "    ALB_URL=\"http://$PUBLIC_HOSTNAME\"",
      "  else",
      "    ALB_URL=\"http://localhost\"",
      "  fi",
      "fi",
      "echo \"Discovered ALB URL: $ALB_URL\"",
      "echo '--- Dynamically discover database credentials ---'",
      "DB_SECRET_ARN=''",
      "echo 'Method 1: CloudFormation outputs...'",
      "DB_SECRET_ARN=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='DatabaseSecretArn'].OutputValue\" --output text 2>/dev/null || echo '')",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Method 2: Secrets discovery by name pattern...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'Moodle') || contains(Name, 'Db') || contains(Name, 'DB')].ARN\" --output text 2>/dev/null | head -1 || echo '')",
      "fi",
      "if [ -z \"$DB_SECRET_ARN\" ] || [ \"$DB_SECRET_ARN\" = \"None\" ]; then",
      "  echo 'Method 3: First available secret...'",
      "  DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[0].ARN\" --output text 2>/dev/null || echo '')",
      "fi",
      "echo \"Discovered DB Secret ARN: $DB_SECRET_ARN\"",
      "echo '--- Get database credentials and endpoint ---'",
      "if [ -n \"$DB_SECRET_ARN\" ] && [ \"$DB_SECRET_ARN\" != \"None\" ]; then",
      "  DB_CREDS=$(aws secretsmanager get-secret-value --region \"$REGION\" --secret-id \"$DB_SECRET_ARN\" --query SecretString --output text 2>/dev/null || echo '')",
      "  if [ -n \"$DB_CREDS\" ]; then",
      "    DB_USER=$(echo \"$DB_CREDS\" | jq -r .username 2>/dev/null || echo '')",
      "    DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password 2>/dev/null || echo '')",
      "    DB_NAME=$(echo \"$DB_CREDS\" | jq -r .dbname 2>/dev/null || echo 'moodle')",
      "    DB_ENDPOINT=$(echo \"$DB_CREDS\" | jq -r .host 2>/dev/null || echo '')",
      "  fi",
      "fi",
      "if [ -z \"$DB_ENDPOINT\" ]; then",
      "  echo 'Discovering DB endpoint from CloudFormation...'",
      "  DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text 2>/dev/null || echo '')",
      "fi",
      "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
      "  echo 'Discovering DB endpoint from RDS...'",
      "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[0].Endpoint.Address\" --output text 2>/dev/null || echo '')",
      "fi",
      "echo \"DB User: $DB_USER\"",
      "echo \"DB Endpoint: $DB_ENDPOINT\"",
      "echo \"DB Name: $DB_NAME\"",
      "echo '--- Validate all discovered parameters ---'",
      "if [ -z \"$ALB_URL\" ] || [ -z \"$DB_ENDPOINT\" ] || [ -z \"$DB_USER\" ] || [ -z \"$DB_PASS\" ]; then",
      "  echo 'ERROR: Missing required parameters:'",
      "  echo \"  ALB_URL: $ALB_URL\"",
      "  echo \"  DB_ENDPOINT: $DB_ENDPOINT\"",
      "  echo \"  DB_USER: $DB_USER\"",
      "  echo \"  DB_PASS: [$([ -n \"$DB_PASS\" ] && echo 'SET' || echo 'EMPTY')]\"",
      "  exit 1",
      "fi",
      "echo '--- Update Moodle configuration dynamically ---'",
      "if [ -f /app/moodle/config.php ]; then",
      "  echo 'Updating existing config.php...'",
      "  cp /app/moodle/config.php /app/moodle/config.php.backup",
      "  sed -i \"s|\\$CFG->wwwroot.*|\\$CFG->wwwroot   = '$ALB_URL';|\" /app/moodle/config.php",
      "  sed -i \"s|\\$CFG->dbhost.*|\\$CFG->dbhost    = '$DB_ENDPOINT';|\" /app/moodle/config.php",
      "  sed -i \"s|\\$CFG->dbuser.*|\\$CFG->dbuser    = '$DB_USER';|\" /app/moodle/config.php",
      "  sed -i \"s|\\$CFG->dbpass.*|\\$CFG->dbpass    = '$DB_PASS';|\" /app/moodle/config.php",
      "  sed -i \"s|\\$CFG->dbname.*|\\$CFG->dbname    = '$DB_NAME';|\" /app/moodle/config.php",
      "else",
      "  echo 'Creating new config.php...'",
      "  cat > /app/moodle/config.php << 'DYNAMIC_CONFIG_EOF'",
      "<?php",
      "unset($CFG);",
      "global $CFG;",
      "$CFG = new stdClass();",
      "",
      "$CFG->dbtype    = 'mariadb';",
      "$CFG->dblibrary = 'native';",
      "DYNAMIC_CONFIG_EOF",
      "  echo \"\\$CFG->dbhost    = '$DB_ENDPOINT';\" >> /app/moodle/config.php",
      "  echo \"\\$CFG->dbname    = '$DB_NAME';\" >> /app/moodle/config.php",
      "  echo \"\\$CFG->dbuser    = '$DB_USER';\" >> /app/moodle/config.php",
      "  echo \"\\$CFG->dbpass    = '$DB_PASS';\" >> /app/moodle/config.php",
      "  cat >> /app/moodle/config.php << 'DYNAMIC_CONFIG_EOF2'",
      "$CFG->prefix    = 'mdl_';",
      "$CFG->dboptions = array (",
      "  'dbpersist' => 0,",
      "  'dbport' => 3306,",
      "  'dbsocket' => '',",
      "  'dbcollation' => 'utf8mb4_unicode_ci',",
      ");",
      "",
      "$CFG->dataroot  = '/data/moodledata';",
      "$CFG->admin     = 'admin';",
      "$CFG->directorypermissions = 0777;",
      "",
      "require_once(__DIR__ . '/lib/setup.php');",
      "DYNAMIC_CONFIG_EOF2",
      "  echo \"\\$CFG->wwwroot   = '$ALB_URL';\" >> /app/moodle/config.php",
      "  sed -i '/require_once/i\\$CFG->wwwroot   = '\\'$ALB_URL\\''\\;' /app/moodle/config.php",
      "  sed -i '/\\$CFG->wwwroot.*require_once/d' /app/moodle/config.php",
      "fi",
      "chown apache:apache /app/moodle/config.php",
      "chmod 644 /app/moodle/config.php",
      "echo '--- Update database wwwroot dynamically ---'",
      "mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -D \"$DB_NAME\" -e \"UPDATE mdl_config SET value='$ALB_URL' WHERE name='wwwroot';\" 2>/dev/null && echo 'Database wwwroot updated' || echo 'Could not update database (may not be initialized yet)'",
      "echo '--- Clear all caches ---'",
      "rm -rf /data/moodledata/cache/* /data/moodledata/localcache/* /data/moodledata/sessions/* /data/moodledata/temp/* 2>/dev/null || echo 'Cache cleared'",
      "echo '--- Restart services ---'",
      "systemctl restart httpd php-fpm",
      "sleep 5",
      "echo '--- Final verification ---'",
      "echo 'Config.php wwwroot:'",
      "grep wwwroot /app/moodle/config.php || echo 'No wwwroot in config'",
      "echo 'Testing localhost:'",
      "curl -sI http://localhost/ | head -3",
      "echo '=== FULLY DYNAMIC FIX COMPLETE ==='"
    ]
  }
}
