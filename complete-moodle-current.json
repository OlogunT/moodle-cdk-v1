{
  "commands": [
    "cd /tmp",
    "export REGION=ca-central-1",
    "export DB_ENDPOINT=moodlecdkstack-moodledatabase37183653-gxqtqhm9exgm.crx38jxk1vhe.ca-central-1.rds.amazonaws.com",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region ca-central-1 --query 'SecretList[?contains(Name, `MoodleDbSecret`)].ARN' --output text)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "echo 'Testing database connection...'",
    "mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -e \"SELECT 1;\"",
    "if [ ! -d \"/app/moodle\" ]; then echo 'Downloading Moodle...'; cd /app; git clone -b main --depth 1 https://github.com/moodle/moodle.git; chown -R apache:apache /app/moodle; fi",
    "mkdir -p /data/moodledata",
    "chown apache:apache /data/moodledata",
    "chmod 777 /data/moodledata",
    "echo 'Configuring PHP...'",
    "cat > /etc/php.d/99-moodle.ini << 'EOF'",
    "max_execution_time = 300",
    "max_input_vars = 5000",
    "memory_limit = 512M",
    "post_max_size = 512M", 
    "upload_max_filesize = 512M",
    "max_file_uploads = 20",
    "session.save_handler = files",
    "session.save_path = \"/tmp\"",
    "opcache.enable = 1",
    "opcache.memory_consumption = 256",
    "opcache.max_accelerated_files = 10000",
    "opcache.revalidate_freq = 60",
    "opcache.use_cwd = 1",
    "opcache.validate_timestamps = 1",
    "opcache.save_comments = 1",
    "opcache.enable_file_override = 0",
    "extension=sodium",
    "date.timezone = \"America/Toronto\"",
    "EOF",
    "echo 'Configuring Apache...'",
    "cat > /etc/httpd/conf.d/moodle.conf << 'EOF'",
    "<VirtualHost *:80>",
    "    DocumentRoot /app/moodle",
    "    ServerName localhost",
    "    ",
    "    <Directory /app/moodle>",
    "        Options -Indexes",
    "        AllowOverride All",
    "        Require all granted",
    "    </Directory>",
    "    ",
    "    ErrorLog /var/log/httpd/moodle_error.log",
    "    CustomLog /var/log/httpd/moodle_access.log combined",
    "</VirtualHost>",
    "EOF",
    "systemctl enable httpd php-fpm",
    "systemctl start httpd php-fpm",
    "echo 'Services started successfully'"
  ]
}
