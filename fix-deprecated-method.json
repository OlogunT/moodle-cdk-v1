{
  "commands": [
    "set -euo pipefail",
    "echo '=== FIX DEPRECATED set_section_number() METHOD ==='",
    "echo ''",
    "echo 'This fix updates deprecated method calls in custom course formats:'",
    "echo '  - menutopic format: lib.php line 113'",
    "echo '  - topcoll format: format_renderer_migration_toolbox.php line 151'",
    "echo ''",
    "echo 'The deprecated method set_section_number() is replaced with set_sectionnum()'",
    "echo 'as per Moodle 4.4+ deprecation notice (MDL-80248)'",
    "echo ''",
    "echo '=== BACKUP FILES BEFORE CHANGES ==='",
    "TIMESTAMP=$(date +%Y%m%d_%H%M%S)",
    "cp /app/moodle/course/format/menutopic/lib.php /app/moodle/course/format/menutopic/lib.php.backup.$TIMESTAMP",
    "cp /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php.backup.$TIMESTAMP",
    "echo \"Backups created with timestamp: $TIMESTAMP\"",
    "echo ''",
    "echo '=== FIX 1: MENUTOPIC FORMAT ==='",
    "echo 'File: /app/moodle/course/format/menutopic/lib.php'",
    "echo 'Line 113: set_section_number() -> set_sectionnum()'",
    "sed -i '113s/set_section_number/set_sectionnum/' /app/moodle/course/format/menutopic/lib.php",
    "echo 'Fixed!'",
    "echo ''",
    "echo '--- Verify change ---'",
    "grep -n 'set_section' /app/moodle/course/format/menutopic/lib.php | grep -E '(113|set_section)'",
    "echo ''",
    "echo '=== FIX 2: TOPCOLL FORMAT ==='",
    "echo 'File: /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php'",
    "echo 'Line 151: set_section_number() -> set_sectionnum()'",
    "sed -i '151s/set_section_number/set_sectionnum/' /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php",
    "echo 'Fixed!'",
    "echo ''",
    "echo '--- Verify change ---'",
    "grep -n 'set_section' /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php | grep -E '(151|set_section)'",
    "echo ''",
    "echo '=== VALIDATE PHP SYNTAX ==='",
    "echo 'Checking menutopic/lib.php...'",
    "php -l /app/moodle/course/format/menutopic/lib.php",
    "echo ''",
    "echo 'Checking topcoll/format_renderer_migration_toolbox.php...'",
    "php -l /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php",
    "echo ''",
    "echo '=== PURGE MOODLE CACHES ==='",
    "echo 'Clearing file caches...'",
    "rm -rf /data/moodledata/cache/* /data/moodledata/localcache/* /data/moodledata/sessions/* 2>/dev/null || true",
    "echo 'Running Moodle cache purge...'",
    "sudo -u apache php /app/moodle/admin/cli/purge_caches.php 2>/dev/null || echo 'CLI cache purge skipped (non-critical)'",
    "echo ''",
    "echo '=== SUMMARY ==='",
    "echo 'Fixed files:'",
    "echo '  1. /app/moodle/course/format/menutopic/lib.php (line 113)'",
    "echo '  2. /app/moodle/course/format/topcoll/classes/output/format_renderer_migration_toolbox.php (line 151)'",
    "echo ''",
    "echo 'Backups saved as:'",
    "echo \"  - menutopic/lib.php.backup.$TIMESTAMP\"",
    "echo \"  - topcoll/classes/output/format_renderer_migration_toolbox.php.backup.$TIMESTAMP\"",
    "echo ''",
    "echo 'The deprecation warning should now be resolved.'",
    "echo 'Test by visiting: https://elearning.tsin.ca/course/index.php?categoryid=34'",
    "echo ''",
    "echo '=== FIX COMPLETE ==='",
    "date"
  ]
}

