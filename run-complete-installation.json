{
  "commands": [
    "curl -o /tmp/complete-moodle-installation.sh https://raw.githubusercontent.com/user/repo/main/complete-moodle-installation.sh || echo 'Download failed, using inline script'",
    "if [ ! -f /tmp/complete-moodle-installation.sh ]; then",
    "cat > /tmp/complete-moodle-installation.sh << 'SCRIPT_EOF'",
    "#!/bin/bash",
    "set -e",
    "echo '=== Complete Moodle Installation Script ==='",
    "echo 'Starting at: $(date)'",
    "TOKEN=$(curl -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s)",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "INSTANCE_ID=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/instance-id)",
    "STACK_NAME='MoodleCdkStack'",
    "echo 'Region: $REGION'",
    "echo 'Instance ID: $INSTANCE_ID'",
    "echo '=== Step 1: Installing packages ==='",
    "dnf install -y httpd php php-fpm php-cli php-common php-curl php-gd php-intl php-ldap php-mbstring php-mysqli php-opcache php-pdo php-soap php-xml php-zip php-sodium php-json php-devel mariadb105 git unzip jq amazon-efs-utils amazon-cloudwatch-agent awscli nfs-utils",
    "echo '=== Step 2: Getting database credentials ==='",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'MoodleDbSecret')].ARN\" --output text | head -1)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text)",
    "echo 'Database endpoint: $DB_ENDPOINT'",
    "mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -e 'SELECT 1;' && echo 'Database OK' || exit 1",
    "echo '=== Step 3: Mounting EFS ==='",
    "DATA_EFS_ID='fs-075a2be536c08840c'",
    "APP_EFS_ID='fs-0c60c5879a0dcecb1'",
    "mkdir -p /data /app",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 \"$DATA_EFS_ID.efs.$REGION.amazonaws.com:/\" /data || echo 'Data EFS mount failed'",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 \"$APP_EFS_ID.efs.$REGION.amazonaws.com:/\" /app || echo 'App EFS mount failed'",
    "chown apache:apache /data /app",
    "echo '=== Step 4: Downloading Moodle ==='",
    "if [ ! -d '/app/moodle' ]; then",
    "  cd /app && git clone -b main --depth 1 https://github.com/moodle/moodle.git",
    "fi",
    "chown -R apache:apache /app/moodle",
    "echo '=== Step 5: Configuring Apache ==='",
    "cat > /etc/httpd/conf.d/moodle.conf << 'EOF'",
    "<VirtualHost *:80>",
    "    DocumentRoot /app/moodle",
    "    ServerName localhost",
    "    DirectoryIndex index.php index.html",
    "    <Directory /app/moodle>",
    "        Options -Indexes +FollowSymLinks",
    "        AllowOverride All",
    "        Require all granted",
    "    </Directory>",
    "    ErrorLog /var/log/httpd/moodle_error.log",
    "    CustomLog /var/log/httpd/moodle_access.log combined",
    "</VirtualHost>",
    "EOF",
    "mv /etc/httpd/conf.d/welcome.conf /etc/httpd/conf.d/welcome.conf.disabled 2>/dev/null || echo 'Welcome disabled'",
    "echo '=== Step 6: Starting services ==='",
    "systemctl enable httpd php-fpm",
    "systemctl start httpd php-fpm",
    "echo '=== Step 7: Preparing Moodle ==='",
    "mkdir -p /data/moodledata",
    "chown apache:apache /data/moodledata",
    "chmod 777 /data/moodledata",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text)",
    "echo 'ALB URL: $ALB_URL'",
    "echo '=== Step 8: Installing Moodle ==='",
    "cd /app/moodle",
    "if [ ! -f 'config.php' ]; then",
    "  sudo -u apache php admin/cli/install.php --lang=en --wwwroot=\"$ALB_URL\" --dataroot='/data/moodledata' --dbtype=mariadb --dbhost=\"$DB_ENDPOINT\" --dbname=moodle --dbuser=\"$DB_USER\" --dbpass=\"$DB_PASS\" --dbport=3306 --prefix=mdl_ --fullname='Touchstone Institute' --shortname='TSI' --adminuser='moodle-admin' --adminpass='TempPass123!' --adminemail='it@tsin.ca' --non-interactive --agree-license",
    "fi",
    "echo '=== Step 9: Creating health check ==='",
    "echo '<?php http_response_code(200); echo \"OK\"; ?>' > /app/moodle/health.php",
    "chown apache:apache /app/moodle/health.php",
    "echo '=== Step 10: Final setup ==='",
    "chown -R apache:apache /app/moodle /data/moodledata",
    "find /app/moodle -type f -exec chmod 644 {} \\;",
    "find /app/moodle -type d -exec chmod 755 {} \\;",
    "chmod -R 777 /data/moodledata",
    "systemctl restart httpd php-fpm",
    "sleep 5",
    "echo '=== Final tests ==='",
    "curl -f http://localhost/health.php && echo 'Health OK' || echo 'Health failed'",
    "curl -f http://localhost/login/index.php >/dev/null && echo 'Moodle OK' || echo 'Moodle failed'",
    "echo '=== Installation Complete! ==='",
    "echo 'Access Moodle at: $ALB_URL'",
    "echo 'Admin: moodle-admin / TempPass123!'",
    "SCRIPT_EOF",
    "fi",
    "chmod +x /tmp/complete-moodle-installation.sh",
    "/tmp/complete-moodle-installation.sh"
  ]
}
