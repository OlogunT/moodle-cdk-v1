{
  "commands": [
    "echo '=== EFS Access Debugging ==='",
    "TOKEN=$(curl -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s)",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "INSTANCE_ID=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/instance-id)",
    "echo \"Region: $REGION\"",
    "echo \"Instance ID: $INSTANCE_ID\"",
    "echo '=== Network Configuration ==='",
    "echo 'Instance subnet:'",
    "aws ec2 describe-instances --instance-ids $INSTANCE_ID --region $REGION --query 'Reservations[*].Instances[*].[SubnetId,SecurityGroups[*].GroupId]' --output table",
    "echo '=== EFS Mount Targets ==='",
    "echo 'Data EFS mount targets:'",
    "aws efs describe-mount-targets --file-system-id fs-075a2be536c08840c --region $REGION --query 'MountTargets[*].[MountTargetId,SubnetId,LifeCycleState,NetworkInterfaceId]' --output table",
    "echo 'App EFS mount targets:'",
    "aws efs describe-mount-targets --file-system-id fs-0c60c5879a0dcecb1 --region $REGION --query 'MountTargets[*].[MountTargetId,SubnetId,LifeCycleState,NetworkInterfaceId]' --output table",
    "echo '=== Security Group Analysis ==='",
    "INSTANCE_SG=$(aws ec2 describe-instances --instance-ids $INSTANCE_ID --region $REGION --query 'Reservations[*].Instances[*].SecurityGroups[0].GroupId' --output text)",
    "echo \"Instance security group: $INSTANCE_SG\"",
    "echo 'Instance SG outbound rules:'",
    "aws ec2 describe-security-groups --group-ids $INSTANCE_SG --region $REGION --query 'SecurityGroups[*].IpPermissionsEgress[*].[IpProtocol,FromPort,ToPort]' --output table",
    "echo '=== DNS Resolution Test ==='",
    "nslookup fs-075a2be536c08840c.efs.$REGION.amazonaws.com",
    "nslookup fs-0c60c5879a0dcecb1.efs.$REGION.amazonaws.com",
    "echo '=== Port Connectivity Test ==='",
    "nc -zv fs-075a2be536c08840c.efs.$REGION.amazonaws.com 2049 || echo 'Port 2049 not reachable for data EFS'",
    "nc -zv fs-0c60c5879a0dcecb1.efs.$REGION.amazonaws.com 2049 || echo 'Port 2049 not reachable for app EFS'",
    "echo '=== Manual Mount Test ==='",
    "mkdir -p /tmp/test-data /tmp/test-app",
    "echo 'Testing data EFS mount:'",
    "mount -v -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-075a2be536c08840c.efs.$REGION.amazonaws.com:/ /tmp/test-data || echo 'Data EFS mount failed'",
    "echo 'Testing app EFS mount:'",
    "mount -v -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-0c60c5879a0dcecb1.efs.$REGION.amazonaws.com:/ /tmp/test-app || echo 'App EFS mount failed'",
    "echo 'Mount results:'",
    "df -h | grep efs || echo 'No EFS mounts found'",
    "echo '=== EFS Debugging Complete ==='",
    "umount /tmp/test-data /tmp/test-app 2>/dev/null || echo 'Cleanup complete'"
  ]
}
