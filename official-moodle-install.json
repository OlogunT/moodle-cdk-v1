{
  "commands": [
    "echo '=== Official Moodle Installation Script ==='",
    "echo 'Based on official Moodle documentation from docs.moodle.org'",
    "set -e",
    "TOKEN=$(curl -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s)",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "echo \"Region: $REGION\"",
    "echo '=== Step 1: Installing required packages ==='",
    "dnf install -y nfs-utils httpd php php-fpm php-cli php-common php-curl php-gd php-intl php-ldap php-mbstring php-mysqli php-opcache php-pdo php-soap php-xml php-zip php-sodium php-json mariadb105 git jq",
    "echo '=== Step 2: Getting database credentials ==='",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, 'MoodleDbSecret')].ARN\" --output text | head -1)",
    "DB_CREDS=$(aws secretsmanager get-secret-value --secret-id \"$DB_SECRET_ARN\" --region \"$REGION\" --query SecretString --output text)",
    "DB_USER=$(echo \"$DB_CREDS\" | jq -r .username)",
    "DB_PASS=$(echo \"$DB_CREDS\" | jq -r .password)",
    "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='DatabaseEndpoint'].OutputValue\" --output text)",
    "echo \"Database: $DB_ENDPOINT\"",
    "echo \"Testing database connection...\"",
    "mysql -h \"$DB_ENDPOINT\" -u \"$DB_USER\" -p\"$DB_PASS\" -e 'SELECT 1;' && echo '✓ Database connection successful'",
    "echo '=== Step 3: Mounting EFS file systems ==='",
    "mkdir -p /data /app",
    "echo 'Mounting data EFS...'",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-075a2be536c08840c.efs.$REGION.amazonaws.com:/ /data && echo '✓ Data EFS mounted'",
    "echo 'Mounting app EFS...'",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-0c60c5879a0dcecb1.efs.$REGION.amazonaws.com:/ /app && echo '✓ App EFS mounted'",
    "chown apache:apache /data /app",
    "echo 'EFS mount verification:'",
    "df -h | grep efs",
    "echo '=== Step 4: Downloading Moodle using official Git method ==='",
    "if [ ! -d '/app/moodle' ]; then",
    "  echo 'Downloading Moodle from official GitHub repository...'",
    "  cd /app",
    "  git clone https://github.com/moodle/moodle.git",
    "  cd moodle",
    "  echo 'Switching to Moodle 5.0 stable branch...'",
    "  git branch --track MOODLE_500_STABLE origin/MOODLE_500_STABLE",
    "  git checkout MOODLE_500_STABLE",
    "  echo '✓ Moodle 5.0 stable branch downloaded successfully'",
    "else",
    "  echo '✓ Moodle already exists'",
    "fi",
    "chown -R apache:apache /app/moodle",
    "echo '=== Step 5: Configuring Apache ==='",
    "cat > /etc/httpd/conf.d/moodle.conf << 'EOF'",
    "<VirtualHost *:80>",
    "    DocumentRoot /app/moodle",
    "    ServerName localhost",
    "    DirectoryIndex index.php index.html",
    "    <Directory /app/moodle>",
    "        Options -Indexes +FollowSymLinks",
    "        AllowOverride All",
    "        Require all granted",
    "    </Directory>",
    "    ErrorLog /var/log/httpd/moodle_error.log",
    "    CustomLog /var/log/httpd/moodle_access.log combined",
    "</VirtualHost>",
    "EOF",
    "mv /etc/httpd/conf.d/welcome.conf /etc/httpd/conf.d/welcome.conf.disabled 2>/dev/null || echo 'Welcome page already disabled'",
    "echo '=== Step 6: Starting services ==='",
    "systemctl enable httpd php-fpm",
    "systemctl start httpd php-fpm",
    "echo 'Service status:'",
    "systemctl is-active httpd && echo '✓ Apache: Active'",
    "systemctl is-active php-fpm && echo '✓ PHP-FPM: Active'",
    "echo '=== Step 7: Preparing Moodle data directory ==='",
    "mkdir -p /data/moodledata",
    "chown apache:apache /data/moodledata",
    "chmod 777 /data/moodledata",
    "echo '=== Step 8: Getting ALB URL ==='",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name MoodleCdkStack --query \"Stacks[0].Outputs[?OutputKey=='MoodleUrl'].OutputValue\" --output text)",
    "echo \"ALB URL: $ALB_URL\"",
    "echo '=== Step 9: Installing Moodle using CLI installer ==='",
    "cd /app/moodle",
    "if [ ! -f 'config.php' ]; then",
    "  echo 'Running Moodle CLI installation (official method)...'",
    "  sudo -u apache php admin/cli/install.php --lang=en --wwwroot=\"$ALB_URL\" --dataroot=/data/moodledata --dbtype=mariadb --dbhost=\"$DB_ENDPOINT\" --dbname=moodle --dbuser=\"$DB_USER\" --dbpass=\"$DB_PASS\" --dbport=3306 --prefix=mdl_ --fullname='Touchstone Institute' --shortname=TSI --adminuser=moodle-admin --adminpass='TempPass123!' --adminemail='it@tsin.ca' --non-interactive --agree-license",
    "  echo '✓ Moodle CLI installation completed successfully'",
    "else",
    "  echo '✓ Moodle already installed, updating configuration...'",
    "  sudo -u apache sed -i \"s|\\$CFG->wwwroot.*|\\$CFG->wwwroot = '$ALB_URL';|\" config.php",
    "fi",
    "echo '=== Step 10: Creating health check endpoint ==='",
    "cat > /app/moodle/health.php << 'EOF'",
    "<?php",
    "// Health check endpoint for ALB",
    "http_response_code(200);",
    "echo 'OK';",
    "?>",
    "EOF",
    "chown apache:apache /app/moodle/health.php",
    "chmod 644 /app/moodle/health.php",
    "echo '=== Step 11: Setting final permissions ==='",
    "chown -R apache:apache /app/moodle /data/moodledata",
    "find /app/moodle -type f -exec chmod 644 {} \\;",
    "find /app/moodle -type d -exec chmod 755 {} \\;",
    "chmod -R 777 /data/moodledata",
    "echo '=== Step 12: Restarting services ==='",
    "systemctl restart httpd php-fpm",
    "sleep 5",
    "echo '=== Step 13: Final health checks ==='",
    "echo 'Testing health endpoint...'",
    "curl -f http://localhost/health.php && echo '✓ Health endpoint working'",
    "echo 'Testing Moodle login page...'",
    "curl -f http://localhost/login/index.php >/dev/null && echo '✓ Moodle login page accessible'",
    "echo 'Testing main Moodle page...'",
    "curl -f http://localhost/ >/dev/null && echo '✓ Main Moodle page accessible'",
    "echo '=== Installation Complete! ==='",
    "echo '🎉 Moodle Installation Summary:'",
    "echo '✓ Official Git method used (MOODLE_500_STABLE branch)'",
    "echo '✓ EFS file systems mounted'",
    "echo '✓ Apache and PHP configured'",
    "echo '✓ Moodle CLI installation completed'",
    "echo '✓ Health check endpoint created'",
    "echo '✓ All services running'",
    "echo ''",
    "echo '🌐 Access Information:'",
    "echo \"Moodle URL: $ALB_URL\"",
    "echo 'Admin username: moodle-admin'",
    "echo 'Admin password: TempPass123!'",
    "echo 'Admin email: it@tsin.ca'",
    "echo ''",
    "echo '⚠️  IMPORTANT: Change the admin password immediately after first login!'",
    "echo ''",
    "echo '📊 System Status:'",
    "df -h | grep efs",
    "systemctl is-active httpd && echo '✓ Apache: Active'",
    "systemctl is-active php-fpm && echo '✓ PHP-FPM: Active'"
  ]
}
