{
  "commands": [
    "echo '=== Testing IMDSv2 Dynamic Discovery ==='",
    "",
    "# Get IMDSv2 token",
    "echo 'Getting IMDSv2 token...'",
    "TOKEN=$(curl -X PUT \"http://169.254.169.254/latest/api/token\" -H \"X-aws-ec2-metadata-token-ttl-seconds: 21600\" -s)",
    "if [ -n \"$TOKEN\" ]; then",
    "  echo '✓ IMDSv2 token obtained'",
    "else",
    "  echo '✗ Failed to get IMDSv2 token'",
    "  exit 1",
    "fi",
    "",
    "# Test region discovery",
    "echo 'Testing region discovery...'",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "echo \"Region: $REGION\"",
    "",
    "# Test instance ID discovery",
    "echo 'Testing instance ID discovery...'",
    "INSTANCE_ID=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/instance-id)",
    "echo \"Instance ID: $INSTANCE_ID\"",
    "",
    "# Test stack name discovery",
    "echo 'Testing stack name discovery...'",
    "STACK_NAME=$(aws ec2 describe-tags --region \"$REGION\" --filters \"Name=resource-id,Values=$INSTANCE_ID\" \"Name=key,Values=aws:cloudformation:stack-name\" --query \"Tags[0].Value\" --output text 2>/dev/null)",
    "if [ -z \"$STACK_NAME\" ] || [ \"$STACK_NAME\" = \"None\" ]; then",
    "  echo 'Warning: Could not determine stack name from tags, using default'",
    "  STACK_NAME=\"MoodleCdkStack\"",
    "fi",
    "echo \"Stack name: $STACK_NAME\"",
    "",
    "# Test CloudFormation outputs",
    "echo 'Testing CloudFormation outputs...'",
    "ALB_URL=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`MoodleUrl\\`].OutputValue\" --output text 2>/dev/null)",
    "DB_ENDPOINT=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`DatabaseEndpoint\\`].OutputValue\" --output text 2>/dev/null)",
    "DATA_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`DataEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "APP_EFS_ID=$(aws cloudformation describe-stacks --region \"$REGION\" --stack-name \"$STACK_NAME\" --query \"Stacks[0].Outputs[?OutputKey==\\`AppEfsId\\`].OutputValue\" --output text 2>/dev/null)",
    "",
    "echo \"ALB URL: $ALB_URL\"",
    "echo \"Database endpoint: $DB_ENDPOINT\"",
    "echo \"Data EFS ID: $DATA_EFS_ID\"",
    "echo \"App EFS ID: $APP_EFS_ID\"",
    "",
    "# Test fallback discovery if CloudFormation outputs not available",
    "if [ -z \"$ALB_URL\" ] || [ \"$ALB_URL\" = \"None\" ]; then",
    "  echo 'Testing ALB fallback discovery...'",
    "  ALB_ARN=$(aws elbv2 describe-load-balancers --region \"$REGION\" --query \"LoadBalancers[?contains(LoadBalancerName, \\`Moodle\\`)].LoadBalancerArn\" --output text 2>/dev/null | head -1)",
    "  if [ -n \"$ALB_ARN\" ]; then",
    "    ALB_DNS_NAME=$(aws elbv2 describe-load-balancers --region \"$REGION\" --load-balancer-arns \"$ALB_ARN\" --query \"LoadBalancers[0].DNSName\" --output text 2>/dev/null)",
    "    ALB_URL=\"http://$ALB_DNS_NAME\"",
    "    echo \"ALB URL (fallback): $ALB_URL\"",
    "  fi",
    "fi",
    "",
    "if [ -z \"$DB_ENDPOINT\" ] || [ \"$DB_ENDPOINT\" = \"None\" ]; then",
    "  echo 'Testing database fallback discovery...'",
    "  DB_ENDPOINT=$(aws rds describe-db-instances --region \"$REGION\" --query \"DBInstances[?contains(DBInstanceIdentifier, \\`moodle\\`) || contains(DBInstanceIdentifier, \\`${STACK_NAME,,}\\`)].Endpoint.Address\" --output text 2>/dev/null | head -1)",
    "  echo \"Database endpoint (fallback): $DB_ENDPOINT\"",
    "fi",
    "",
    "# Test secret discovery",
    "echo 'Testing secret discovery...'",
    "DB_SECRET_ARN=$(aws secretsmanager list-secrets --region \"$REGION\" --query \"SecretList[?contains(Name, \\`MoodleDbSecret\\`) || contains(Name, \\`${STACK_NAME}\\`)].ARN\" --output text | head -1)",
    "echo \"Database secret ARN: $DB_SECRET_ARN\"",
    "",
    "# Summary",
    "echo '=== Discovery Summary ==='",
    "echo \"✓ Region: $REGION\"",
    "echo \"✓ Instance ID: $INSTANCE_ID\"",
    "echo \"✓ Stack name: $STACK_NAME\"",
    "echo \"✓ ALB URL: $ALB_URL\"",
    "echo \"✓ Database: $DB_ENDPOINT\"",
    "echo \"✓ Secret ARN: $DB_SECRET_ARN\"",
    "echo \"✓ Data EFS: $DATA_EFS_ID\"",
    "echo \"✓ App EFS: $APP_EFS_ID\"",
    "",
    "# Validate all required parameters are discovered",
    "MISSING=0",
    "[ -z \"$REGION\" ] && echo '✗ Missing: Region' && MISSING=1",
    "[ -z \"$STACK_NAME\" ] && echo '✗ Missing: Stack name' && MISSING=1",
    "[ -z \"$ALB_URL\" ] && echo '✗ Missing: ALB URL' && MISSING=1",
    "[ -z \"$DB_ENDPOINT\" ] && echo '✗ Missing: Database endpoint' && MISSING=1",
    "[ -z \"$DB_SECRET_ARN\" ] && echo '✗ Missing: Database secret ARN' && MISSING=1",
    "[ -z \"$DATA_EFS_ID\" ] && echo '✗ Missing: Data EFS ID' && MISSING=1",
    "[ -z \"$APP_EFS_ID\" ] && echo '✗ Missing: App EFS ID' && MISSING=1",
    "",
    "if [ $MISSING -eq 0 ]; then",
    "  echo '🎉 All parameters successfully discovered!'",
    "  echo 'Dynamic discovery is working correctly.'",
    "else",
    "  echo '⚠️  Some parameters could not be discovered.'",
    "  echo 'Check CloudFormation outputs and resource tags.'",
    "fi"
  ]
}
