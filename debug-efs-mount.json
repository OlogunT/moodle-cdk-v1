{
  "commands": [
    "echo 'Debugging EFS mount issues...'",
    "echo 'Current mount status:'",
    "df -h",
    "echo 'Checking if EFS mount points exist:'",
    "ls -la /data /app",
    "echo 'Testing EFS connectivity:'",
    "TOKEN=$(curl -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s)",
    "REGION=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" -s http://169.254.169.254/latest/meta-data/placement/region)",
    "echo \"Region: $REGION\"",
    "echo 'Testing DNS resolution:'",
    "nslookup fs-075a2be536c08840c.efs.ca-central-1.amazonaws.com",
    "nslookup fs-0c60c5879a0dcecb1.efs.ca-central-1.amazonaws.com",
    "echo 'Checking EFS mount targets:'",
    "aws efs describe-mount-targets --file-system-id fs-075a2be536c08840c --region ca-central-1",
    "echo 'Attempting manual NFS4 mount:'",
    "mkdir -p /data /app",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-075a2be536c08840c.efs.ca-central-1.amazonaws.com:/ /data",
    "mount -t nfs4 -o nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 fs-0c60c5879a0dcecb1.efs.ca-central-1.amazonaws.com:/ /app",
    "echo 'Mount results:'",
    "df -h | grep efs",
    "echo 'Setting permissions:'",
    "chown apache:apache /data /app",
    "chmod 755 /data /app",
    "echo 'EFS mount debugging complete!'"
  ]
}
